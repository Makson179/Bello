+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
 use codex_protocol::openai_models::ModelInfo;
 
+/// The summary prompt asks for plain text of at most about this many characters.
+pub(crate) const BELLO_SUMMARY_TARGET_CHARS: usize = 16_000;
+/// Plain-text summaries longer than this are rejected, never truncated.
+pub(crate) const BELLO_SUMMARY_MAX_CHARS: usize = 48_000;
+/// Output room for a summary of the requested size, at the ~4 characters per token
+/// estimate used throughout compaction. A reply longer than the target is accepted
+/// only up to the maximum and only if the request still fits the model window.
+pub(crate) const BELLO_SUMMARY_OUTPUT_RESERVE: i64 = (BELLO_SUMMARY_TARGET_CHARS / 4) as i64;
+/// Extra input headroom for estimation error and request overhead.
+pub(crate) const BELLO_CONTEXT_SAFETY_MARGIN: i64 = 4_096;
+
+/// The most input any Bello compaction request may carry: model capacity minus
+/// the summary output reserve and the safety margin.
+pub(crate) fn bello_input_budget(capacity: i64) -> i64 {
+    capacity.saturating_sub(BELLO_SUMMARY_OUTPUT_RESERVE + BELLO_CONTEXT_SAFETY_MARGIN)
+}
+
+/// Bello's configured threshold is a contract, not a hint to the model's
+/// ordinary 90%-window auto-compaction policy. Reject incompatible settings
+/// explicitly rather than silently lowering the threshold or retained tail.
+pub(crate) fn bello_context_threshold(config: &Config, model: &ModelInfo) -> CodexResult<i64> {
+    let threshold = config.model_auto_compact_token_limit.unwrap_or(249_000);
+    if threshold <= 0 {
+        return Err(CodexErr::Stream(format!(
+            "no-need-for-context: configured threshold {threshold} must be positive"
+        )));
+    }
+    let capacity = model.usable_context_window().ok_or_else(|| {
+        CodexErr::Stream(format!(
+            "no-need-for-context: model {} context capacity is unknown; configured threshold {threshold} cannot be validated",
+            model.slug
+        ))
+    })?;
+    let maximum = bello_input_budget(capacity);
+    if threshold > maximum {
+        return Err(CodexErr::Stream(format!(
+            "no-need-for-context: configured threshold {threshold} exceeds model {} safe input budget {maximum} (usable context {capacity}, summary output reserve {BELLO_SUMMARY_OUTPUT_RESERVE}, safety margin {BELLO_CONTEXT_SAFETY_MARGIN}); threshold was not changed",
+            model.slug
+        )));
+    }
+    Ok(threshold)
+}

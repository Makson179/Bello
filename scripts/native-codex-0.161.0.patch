new file mode 100644
index 0000000000000000000000000000000000000000..2b012262ea5243731e2503fe0d2edfcf5f2e66ea
--- /dev/null
+++ b/codex-rs/windows-sandbox-rs/src/setup_transaction.rs
@@ -0,0 +1,230 @@
+//! Setup-only cross-process exclusion. Parents own the request lock; helpers and
+//! authenticated in-process provisioning own the mutation lock. A surviving
+//! helper therefore remains protected if its parent dies. Account provisioning
+//! takes the upstream machine-wide lock before mutation exclusion. Neither of
+//! these per-owner locks is held while running a sandboxed command.
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::bail;
+use base64::Engine;
+use base64::engine::general_purpose::STANDARD as BASE64;
+use std::io;
+use std::marker::PhantomData;
+use std::os::windows::io::AsRawHandle;
+use std::os::windows::io::FromRawHandle;
+use std::os::windows::io::OwnedHandle;
+use std::ptr::null_mut;
+use windows_sys::Win32::Foundation::HANDLE;
+use windows_sys::Win32::Foundation::HLOCAL;
+use windows_sys::Win32::Foundation::LocalFree;
+use windows_sys::Win32::Foundation::WAIT_ABANDONED;
+use windows_sys::Win32::Foundation::WAIT_OBJECT_0;
+use windows_sys::Win32::Foundation::WAIT_TIMEOUT;
+use windows_sys::Win32::Security::Authorization::ConvertStringSecurityDescriptorToSecurityDescriptorW;
+use windows_sys::Win32::Security::Authorization::ConvertStringSidToSidW;
+use windows_sys::Win32::Security::Cryptography::BCRYPT_USE_SYSTEM_PREFERRED_RNG;
+use windows_sys::Win32::Security::Cryptography::BCryptGenRandom;
+use windows_sys::Win32::Security::GetLengthSid;
+use windows_sys::Win32::Security::SECURITY_ATTRIBUTES;
+use windows_sys::Win32::Security::TOKEN_QUERY;
+use windows_sys::Win32::System::Threading::CreateMutexW;
+use windows_sys::Win32::System::Threading::GetCurrentProcess;
+use windows_sys::Win32::System::Threading::ReleaseMutex;
+use windows_sys::Win32::System::Threading::WaitForSingleObject;
+
+use crate::setup_error::SetupErrorCode;
+use crate::setup_error::failure;
+use crate::token::get_user_sid_bytes;
+use crate::winutil::resolve_sid;
+use crate::winutil::string_from_sid_bytes;
+use crate::winutil::to_wide;
+
+const SETUP_LOCK_TIMEOUT_MS: u32 = 120_000;
+
+/// A non-inheritable mutex owned by its acquiring thread only.
+#[must_use]
+pub struct SetupTransactionLock {
+    handle: OwnedHandle,
+    _thread_bound: PhantomData<*mut ()>,
+}
+
+impl Drop for SetupTransactionLock {
+    fn drop(&mut self) {
+        unsafe { ReleaseMutex(self.handle.as_raw_handle() as HANDLE) };
+    }
+}
+
+fn current_user_sid() -> Result<String> {
+    #[link(name = "advapi32")]
+    unsafe extern "system" {
+        fn OpenProcessToken(process: HANDLE, desired_access: u32, token: *mut HANDLE) -> i32;
+    }
+    let mut token = 0;
+    if unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) } == 0 {
+        return Err(io::Error::last_os_error()).context("query setup caller identity");
+    }
+    let token = unsafe { OwnedHandle::from_raw_handle(token as _) };
+    let bytes = unsafe { get_user_sid_bytes(token.as_raw_handle() as HANDLE) }?;
+    string_from_sid_bytes(&bytes).map_err(anyhow::Error::msg)
+}
+
+fn validate_sid(sid: &str) -> Result<()> {
+    // Accept only canonical numeric SIDs, never account names or SDDL fragments.
+    if !sid.starts_with("S-1-") || !sid[4..].chars().all(|ch| ch.is_ascii_digit() || ch == '-') {
+        bail!("invalid setup lock SID");
+    }
+    let mut raw = null_mut();
+    if unsafe { ConvertStringSidToSidW(to_wide(sid).as_ptr(), &mut raw) } == 0 {
+        return Err(io::Error::last_os_error()).context("parse setup lock SID");
+    }
+    let bytes = unsafe { std::slice::from_raw_parts(raw.cast(), GetLengthSid(raw) as usize) };
+    let canonical = string_from_sid_bytes(bytes).map_err(anyhow::Error::msg);
+    unsafe { LocalFree(raw as HLOCAL) };
+    if canonical? != sid {
+        bail!("setup lock SID is not canonical");
+    }
+    Ok(())
+}
+
+fn request_lock_sid(payload: &serde_json::Value) -> Result<String> {
+    if payload.get("mode").and_then(serde_json::Value::as_str) == Some("provision-only") {
+        // Managed provisioning already requires elevation and explicitly targets
+        // another user. Coordinate with that user's ordinary full/refresh setup,
+        // not with the administrator's own CODEX_HOME.
+        let user = payload
+            .get("real_user")
+            .and_then(serde_json::Value::as_str)
+            .context("provisioning payload requires a target user")?;
+        string_from_sid_bytes(&resolve_sid(user)?).map_err(anyhow::Error::msg)
+    } else {
+        // Never use USERNAME or any other payload-controlled account name for
+        // ordinary setup. UAC helpers retain this original token-derived SID.
+        current_user_sid()
+    }
+}
+
+fn acquire_named_lock(name: &str, sid: &str, timeout_ms: u32) -> Result<SetupTransactionLock> {
+    validate_sid(sid)?;
+    // Explicit medium integrity lets the unelevated parent and UAC-elevated
+    // helper share this synchronization object. Its protected DACL still grants
+    // access only to SYSTEM, administrators, and the originating real user.
+    let sddl = to_wide(format!(
+        "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;{sid})S:(ML;;NW;;;ME)"
+    ));
+    let mut descriptor = null_mut();
+    if unsafe {
+        ConvertStringSecurityDescriptorToSecurityDescriptorW(
+            sddl.as_ptr(),
+            /*stringsdrevision*/ 1,
+            &mut descriptor,
+            null_mut(),
+        )
+    } == 0
+    {
+        return Err(io::Error::last_os_error()).context("create setup lock security");
+    }
+    let attributes = SECURITY_ATTRIBUTES {
+        nLength: size_of::<SECURITY_ATTRIBUTES>() as u32,
+        lpSecurityDescriptor: descriptor,
+        bInheritHandle: 0,
+    };
+    let raw = unsafe {
+        CreateMutexW(
+            &attributes,
+            /*binitialowner*/ 0,
+            to_wide(name).as_ptr(),
+        )
+    };
+    let opened = if raw == 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(unsafe { OwnedHandle::from_raw_handle(raw as _) })
+    };
+    unsafe { LocalFree(descriptor as HLOCAL) };
+    let handle = opened.context("open setup transaction mutex")?;
+    match unsafe { WaitForSingleObject(handle.as_raw_handle() as HANDLE, timeout_ms) } {
+        WAIT_OBJECT_0 => Ok(SetupTransactionLock {
+            handle,
+            _thread_bound: PhantomData,
+        }),
+        WAIT_ABANDONED => {
+            // Windows grants ownership on abandonment. Release it, but do not
+            // use possibly partial setup state or treat this request as success.
+            unsafe { ReleaseMutex(handle.as_raw_handle() as HANDLE) };
+            bail!("setup transaction mutex was abandoned; refusing this setup request")
+        }
+        WAIT_TIMEOUT => bail!("setup transaction mutex timed out after {timeout_ms} ms"),
+        _ => Err(io::Error::last_os_error()).context("wait for setup transaction mutex"),
+    }
+}
+
+fn acquire_lock(kind: &str, sid: &str) -> Result<SetupTransactionLock> {
+    acquire_named_lock(
+        &format!(r"Global\CodexSandboxSetupV1-{kind}-{sid}"),
+        sid,
+        SETUP_LOCK_TIMEOUT_MS,
+    )
+    .map_err(|err| {
+        failure(
+            SetupErrorCode::SetupTransactionLockFailed,
+            format!("{err:#}"),
+        )
+    })
+}
+
+/// Held by a helper or authenticated service across mutations and report writes.
+/// A parent may briefly acquire it before launch or after child exit, never
+/// across child wait. Provisioning acquires the machine-wide account lock first.
+pub fn acquire_setup_mutation_lock(sid: &str) -> Result<SetupTransactionLock> {
+    acquire_lock("Mutation", sid)
+}
+
+pub(crate) struct SetupRequest {
+    pub(crate) payload_b64: String,
+    pub(crate) request_id: String,
+    pub(crate) sid: String,
+    _request_lock: SetupTransactionLock,
+}
+
+impl SetupRequest {
+    pub(crate) fn begin(payload_b64: &str) -> Result<Self> {
+        let mut payload: serde_json::Value = serde_json::from_slice(&BASE64.decode(payload_b64)?)?;
+        let sid = request_lock_sid(&payload)?;
+        let request_lock = acquire_lock("Request", &sid)?;
+        let mut nonce = [0u8; 16];
+        let status = unsafe {
+            BCryptGenRandom(
+                /*halgorithm*/ null_mut(),
+                nonce.as_mut_ptr(),
+                nonce.len() as u32,
+                BCRYPT_USE_SYSTEM_PREFERRED_RNG,
+            )
+        };
+        if status < 0 {
+            bail!("generate setup request id failed: {status}");
+        }
+        let request_id = nonce
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect::<String>();
+        // This runs only for the launching request, after any singleflight
+        // election. Retained-handle service requests deliberately do not join a
+        // flight; neither path adds random metadata to a coalescing key.
+        let object = payload
+            .as_object_mut()
+            .context("setup payload must be an object")?;
+        object.insert("setup_lock_sid".to_string(), sid.clone().into());
+        object.insert("setup_request_id".to_string(), request_id.clone().into());
+        Ok(Self {
+            payload_b64: BASE64.encode(serde_json::to_vec(&payload)?),
+            request_id,
+            sid,
+            _request_lock: request_lock,
+        })
+    }
+}

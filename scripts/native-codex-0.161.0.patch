+async fn queued_steer_wakes_once_until_it_reaches_history() {
+    let queue = Arc::new(AsyncTools::default());
+    let (activity, _) = watch::channel(1);
+    let _first = gated_call(&queue, BatchId(0), "first").await;
+    let started = Instant::now();

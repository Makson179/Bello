+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+
+struct ImmediateTool(ToolName);
+
+impl ToolExecutor<ToolInvocation> for ImmediateTool {
+    fn tool_name(&self) -> ToolName {
+        self.0.clone()
+    }
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Function(codex_tools::ResponsesApiTool {
+            name: self.0.name.to_string(),
+            description: "native async gate test".to_string(),
+            strict: false,
+            parameters: codex_tools::JsonSchema::default(),
+            defer_loading: None,
+            output_schema: None,
+        })
+    }
+    fn handle<'a>(&'a self, _: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async {
+            Ok(crate::tools::context::boxed_tool_output(
+                FunctionToolOutput::from_text("done".to_string(), Some(true)),
+            ))
+        })
+    }
+}
+impl CoreToolRuntime for ImmediateTool {}
+
+fn step(mut turn: TurnContext, name: &str) -> Arc<StepContext> {
+    let mut config = (*turn.config).clone();
+    config.features.enable(Feature::BelloAsyncTools).unwrap();
+    turn.config = Arc::new(config);
+    let step = StepContext::for_test(Arc::new(turn));
+    let tool = Arc::new(ImmediateTool(ToolName::plain(name))) as Arc<dyn CoreToolRuntime>;
+    step.with_tool_router_for_test(Arc::new(ToolRouter::from_parts(
+        ToolRegistry::from_tools([tool]),
+        Vec::new(),
+        ToolMode::Direct,
+        BTreeMap::new(),
+        None,
+        &[],
+    )))
+}

+#[test]
+fn sid_validation_rejects_names_and_descriptor_injection() {
+    for sid in [
+        "Everyone",
+        "SY",
+        "S-1-5-18)(A;;GA;;;WD)",
+        "S-1-5-",
+        "S-1-05-18",
+    ] {
+        assert!(validate_sid(sid).is_err(), "accepted {sid}");
+    }
+    validate_sid(&current_user_sid().expect("caller SID")).expect("canonical token SID");
+}

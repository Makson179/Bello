new file mode 100644
index 0000000000000000000000000000000000000000..76d83baeb411be6631df635380144f59b1056c31
--- /dev/null
+++ b/codex-rs/core/src/tools/code_mode/native_async_response.rs
@@ -0,0 +1,72 @@
+//! Host-only waiting for Bello native async cells. A yielded cell does not need
+//! another inference call merely because its transport wait interval elapsed.
+
+use std::future::Future;
+use std::time::Duration;
+
+use codex_code_mode::CellId;
+use codex_code_mode::RuntimeResponse;
+use codex_code_mode::WaitOutcome;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use tokio_util::sync::CancellationToken;
+
+use super::response_adapter::into_function_call_output_content_items;
+use super::truncate_code_mode_result;
+
+pub(super) struct BufferedRuntimeResponse {
+    pub(super) response: RuntimeResponse,
+    pub(super) earlier_content: Vec<FunctionCallOutputContentItem>,
+    pub(super) host_duration: Option<Duration>,
+    pub(super) waited_cell: Option<CellId>,
+}
+
+pub(super) async fn collect_runtime_response<W, F>(
+    mut response: RuntimeResponse,
+    native_async: bool,
+    preempt: Option<CancellationToken>,
+    max_output_tokens: Option<usize>,
+    mut wait: W,
+) -> Result<BufferedRuntimeResponse, String>
+where
+    W: FnMut(CellId, Option<CancellationToken>) -> F,
+    F: Future<Output = Result<WaitOutcome, String>>,
+{
+    let mut earlier_content = Vec::new();
+    let mut host_duration = response.code_mode_host_duration();
+    let mut waited_cell = None;
+    while native_async
+        && !preempt
+            .as_ref()
+            .is_some_and(CancellationToken::is_cancelled)
+    {
+        let RuntimeResponse::Yielded {
+            cell_id,
+            content_items,
+            ..
+        } = response
+        else {
+            break;
+        };
+        waited_cell = Some(cell_id.clone());
+        earlier_content.extend(into_function_call_output_content_items(content_items));
+        // Bound the aggregate at every yield, not just after a long-running
+        // cell finishes. Final formatting applies the same total budget.
+        earlier_content = truncate_code_mode_result(earlier_content, max_output_tokens);
+        response = wait(cell_id, preempt.clone()).await?.into();
+        host_duration = host_duration
+            .zip(response.code_mode_host_duration())
+            .map(|(earlier, current)| earlier.saturating_add(current));
+        // A preempted wait returns Yielded. The loop condition must stop here:
+        // retrying with its already-cancelled token would spin forever.
+    }
+    Ok(BufferedRuntimeResponse {
+        response,
+        earlier_content,
+        host_duration,
+        waited_cell,
+    })
+}
+
+#[cfg(test)]
+#[path = "native_async_response_tests.rs"]
+mod tests;

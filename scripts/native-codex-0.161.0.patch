+use std::collections::VecDeque;
+use std::future::ready;
+
+use super::*;
+use codex_code_mode::FunctionCallOutputContentItem as RuntimeContent;
+use pretty_assertions::assert_eq;
+
+fn yielded(text: &str, millis: u64) -> RuntimeResponse {
+    RuntimeResponse::Yielded {
+        cell_id: CellId::new("cell".to_string()),
+        content_items: vec![RuntimeContent::InputText {
+            text: text.to_string(),
+        }],
+        code_mode_host_duration: Some(Duration::from_millis(millis)),
+    }
+}
+
+fn completed(text: &str, millis: u64) -> RuntimeResponse {
+    RuntimeResponse::Result {
+        cell_id: CellId::new("cell".to_string()),
+        content_items: vec![RuntimeContent::InputText {
+            text: text.to_string(),
+        }],
+        error_text: None,
+        code_mode_host_duration: Some(Duration::from_millis(millis)),
+    }
+}
+
+#[tokio::test]
+async fn native_async_waits_without_inference_and_preserves_each_output_and_timing() {
+    let mut responses = VecDeque::from([yielded("second", 20), completed("last", 30)]);
+    let buffered = collect_runtime_response(
+        yielded("first", 10),
+        true,
+        None,
+        Some(1_000),
+        |cell_id, preempt| {
+            assert_eq!(cell_id, CellId::new("cell".to_string()));
+            assert!(preempt.is_none());
+            ready(Ok(WaitOutcome::LiveCell(responses.pop_front().unwrap())))
+        },
+    )
+    .await
+    .unwrap();
+    assert!(responses.is_empty());
+    assert_eq!(buffered.response, completed("last", 30));
+    assert_eq!(
+        buffered.earlier_content,
+        vec![
+            FunctionCallOutputContentItem::InputText {
+                text: "first".to_string(),
+            },
+            FunctionCallOutputContentItem::InputText {
+                text: "second".to_string(),
+            },
+        ]
+    );
+    assert_eq!(buffered.host_duration, Some(Duration::from_millis(60)));
+    assert_eq!(buffered.waited_cell, Some(CellId::new("cell".to_string())));
+}
+
+#[tokio::test]
+async fn disabled_native_async_preserves_upstream_yield_without_waiting() {
+    let response = yielded("original", 10);
+    let buffered = collect_runtime_response(response.clone(), false, None, Some(1_000), |_, _| {
+        panic!("disabled async must not issue a host wait");
+        #[allow(unreachable_code)]
+        ready(Err("unreachable".to_string()))
+    })
+    .await
+    .unwrap();
+    assert_eq!(buffered.response, response);
+    assert!(buffered.earlier_content.is_empty());
+    assert!(buffered.waited_cell.is_none());
+    assert_eq!(buffered.host_duration, Some(Duration::from_millis(10)));
+}
+
+#[tokio::test]
+async fn already_preempted_step_preserves_live_cell_without_waiting() {
+    let preempt = CancellationToken::new();
+    preempt.cancel();
+    let response = yielded("original", 10);
+    let buffered = collect_runtime_response(
+        response.clone(),
+        true,
+        Some(preempt),
+        Some(1_000),
+        |_, _| {
+            panic!("preempted step must not wait again");
+            #[allow(unreachable_code)]
+            ready(Err("unreachable".to_string()))
+        },
+    )
+    .await
+    .unwrap();
+    assert_eq!(buffered.response, response);
+    assert!(buffered.earlier_content.is_empty());
+    assert!(buffered.waited_cell.is_none());
+}
+
+#[tokio::test]
+async fn preempt_during_wait_preserves_yielded_output_and_never_spins() {
+    let preempt = CancellationToken::new();
+    let mut waits = 0;
+    let buffered = collect_runtime_response(
+        yielded("before", 10),
+        true,
+        Some(preempt.clone()),
+        Some(1_000),
+        |_, token| {
+            waits += 1;
+            token.unwrap().cancel();
+            ready(Ok(WaitOutcome::LiveCell(yielded("on steer", 20))))
+        },
+    )
+    .await
+    .unwrap();
+    assert!(preempt.is_cancelled());
+    assert_eq!(waits, 1);
+    assert_eq!(buffered.response, yielded("on steer", 20));
+    assert_eq!(
+        buffered.earlier_content,
+        vec![FunctionCallOutputContentItem::InputText {
+            text: "before".to_string(),
+        }]
+    );
+    assert_eq!(buffered.host_duration, Some(Duration::from_millis(30)));
+}
+
+#[tokio::test]
+async fn buffered_output_stays_bounded_across_many_yields() {
+    let mut waits = 0;
+    let buffered = collect_runtime_response(
+        yielded(&"x".repeat(10_000), 1),
+        true,
+        None,
+        Some(32),
+        |_, _| {
+            waits += 1;
+            ready(Ok(WaitOutcome::LiveCell(if waits < 100 {
+                yielded(&"y".repeat(10_000), 1)
+            } else {
+                completed("done", 1)
+            })))
+        },
+    )
+    .await
+    .unwrap();
+    let bytes: usize = buffered
+        .earlier_content
+        .iter()
+        .map(|item| match item {
+            FunctionCallOutputContentItem::InputText { text } => text.len(),
+            _ => panic!("text-only test"),
+        })
+        .sum();
+    assert!(bytes < 1_024, "aggregate must not grow with yield count");
+    assert_eq!(waits, 100);
+    assert_eq!(buffered.response, completed("done", 1));
+}
+
+#[tokio::test]
+async fn missing_host_measurement_does_not_fabricate_complete_timing() {
+    let mut response = completed("done", 1);
+    if let RuntimeResponse::Result {
+        code_mode_host_duration,
+        ..
+    } = &mut response
+    {
+        *code_mode_host_duration = None;
+    }
+    let buffered =
+        collect_runtime_response(yielded("before", 10), true, None, Some(1_000), |_, _| {
+            ready(Ok(WaitOutcome::LiveCell(response.clone())))
+        })
+        .await
+        .unwrap();
+    assert!(buffered.host_duration.is_none());
+}
+
+#[tokio::test]
+async fn terminal_failure_is_preserved_after_buffered_yield() {
+    let mut failed = completed("diagnostic", 20);
+    if let RuntimeResponse::Result { error_text, .. } = &mut failed {
+        *error_text = Some("script failure".to_string());
+    }
+    let buffered =
+        collect_runtime_response(yielded("before", 10), true, None, Some(1_000), |_, _| {
+            ready(Ok(WaitOutcome::LiveCell(failed.clone())))
+        })
+        .await
+        .unwrap();
+    assert_eq!(buffered.response, failed);
+    assert_eq!(buffered.host_duration, Some(Duration::from_millis(30)));
+}
+
+#[tokio::test]
+async fn host_wait_errors_propagate_without_becoming_successful_results() {
+    let result =
+        collect_runtime_response(yielded("before", 10), true, None, Some(1_000), |_, _| {
+            ready(Err("host unavailable".to_string()))
+        })
+        .await;
+    assert_eq!(result.err(), Some("host unavailable".to_string()));
+}

+    assert!(!waiting.is_finished());
+    activity.send_replace(2);
+    assert_eq!(waiting.await.unwrap().unwrap().len(), 1);
+    // After the turn consumes the input, a distinct queued steer wakes again.
+    let fourth = gated_call(&queue, BatchId(3), "fourth").await;
+    let collecting = Arc::clone(&queue);
+    let receiver = activity.subscribe();
+    let waiting = tokio::spawn(async move {

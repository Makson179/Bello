+    fn bello_context_summarizer_tool_use_is_unusable() {
+        let call: ResponseItem = serde_json::from_value(
+            json!({"type":"function_call","name":"exec","call_id":"c","arguments":"{}"}),
+        )
+        .unwrap();
+        let text: ResponseItem = serde_json::from_value(
+            json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"handoff"}]}),
+        )
+        .unwrap();
+        assert!(tool_use(&call));
+        assert!(!tool_use(&text));
+    }
+
+    #[test]
+    fn bello_context_late_result_pins_original_call_but_not_as_human_correction() {
+        let mut items = rounds();
+        items.insert(4, message("user", "real latest correction"));
+        let mut late = message(
+            "user",
+            "<bello_async_tool_result>\nCompleted call_id: \"call-0\"",
+        );
+        late.metadata.get_or_insert_default().bello_async_call_id = Some("call-0".into());
+        items.push(late);
+        let p = plan(&items, 1, &HashSet::new()).unwrap();
+        assert!(p.keep[2] && p.keep[3] && p.keep[4]);
+        assert!(*p.keep.last().unwrap());
+        assert!(!p.keep[5]);
+    }
+
+    #[test]
+    fn bello_context_consecutive_late_results_do_not_pin_the_whole_history() {
+        // Every round's result arrives as a late message in the following round,
+        // as when each call outlives its own collection window.
+        let call = |n: usize| {
+            item(
+                json!({"type":"function_call","name":"exec","call_id":format!("call-{n}"),"arguments":"{}"}),
+            )
+        };
+        let marker = |n: usize| {
+            item(
+                json!({"type":"function_call_output","call_id":format!("call-{n}"),"output":"still running"}),
+            )
+        };
+        let late = |n: usize| {
+            let mut late = message(
+                "user",
+                &format!(
+                    "<bello_async_tool_result>\nCompleted call_id: \"call-{n}\"\n{}",
+                    "x".repeat(400)
+                ),
+            );
+            late.metadata.get_or_insert_default().bello_async_call_id = Some(format!("call-{n}"));
+            late
+        };
+        let mut items = vec![
+            message("developer", "never delete"),
+            message("user", "original task"),
+            call(0),
+            marker(0),
+        ];
+        // 4 call-1, 5 late-0, 6 marker-1 | 7 call-2, 8 late-1, 9 marker-2 | 10 call-3, 11 late-2, 12 marker-3
+        for n in 1..4 {
+            items.extend([call(n), late(n - 1), marker(n)]);
+        }
+        // 13 newest response, 14 fresh late result of call-3.
+        items.push(item(
+            json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"waiting"}]}),
+        ));
+        items.push(late(3));
+        let p = plan(&items, 1, &HashSet::new()).unwrap();
+        assert!(p.keep[0] && p.keep[1]);
+        // The fresh result keeps its own call and marker verbatim.
+        assert!(p.keep[13] && p.keep[14] && p.keep[10] && p.keep[12]);
+        // The older call's result inside that retained round is summarized with
+        // its own call instead of pinning every earlier round.
+        assert!(!p.keep[11]);
+        for index in 2..10 {
+            assert!(!p.keep[index], "item {index} should be summarized");
+        }
+    }
+}

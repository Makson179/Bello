+async fn authenticated_tcp_peer(listener: tokio::net::TcpListener, response: Value) -> Value {
+    let (mut stream, _) = listener.accept().await.unwrap();
+    let hello = read_record(&mut stream, 1024).await.unwrap();
+    assert_eq!(hello.as_object().unwrap().len(), 2);
+    assert_eq!(hello["version"], json!(1));
+    let client_nonce = hello["nonce"].as_str().unwrap();
+    assert!(decode_hex32(client_nonce).is_some());
+    let server_nonce = "24".repeat(32);
+    let proof = authentication_mac(
+        &[0x42; 32],
+        b"bello-selector-server-v1\0",
+        client_nonce,
+        &server_nonce,
+    )
+    .finalize()
+    .into_bytes();
+    send_record(
+        &mut stream,
+        &json!({"nonce": server_nonce, "proof": encode_hex32(&proof)}),
+    )
+    .await
+    .unwrap();
+    let mut request = read_record(&mut stream, 4096).await.unwrap();
+    let auth = decode_hex32(request["auth"].as_str().unwrap()).unwrap();
+    authentication_mac(
+        &[0x42; 32],
+        b"bello-selector-client-v1\0",
+        client_nonce,
+        &server_nonce,
+    )
+    .verify_slice(&auth)
+    .unwrap();
+    request.as_object_mut().unwrap().remove("auth");
+    send_record(&mut stream, &response).await.unwrap();
+    request
+}

+    struct TimedOutput(Arc<AtomicU64>);
+    impl ToolOutput for TimedOutput {
+        fn log_output(&self) -> String {
+            String::new()
+        }
+        fn success_for_logging(&self) -> bool {
+            true
+        }
+        fn set_handler_duration_ms(&mut self, duration: u64) {
+            self.0.store(duration, Ordering::Relaxed);
+        }
+        fn to_response_item(&self, call_id: &str, _: &ToolPayload) -> ResponseInputItem {

+use super::*;
+use pretty_assertions::assert_eq;
+use std::fs;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Child;
+use std::process::Command;
+use std::thread;
+use std::time::Duration;
+use std::time::Instant;
+use windows_sys::Win32::System::Threading::MUTEX_ALL_ACCESS;
+use windows_sys::Win32::System::Threading::OpenMutexW;
+
+const CHILD_TEST: &str = "setup_transaction::tests::setup_mutex_child";
+
+struct Actor {
+    child: Child,
+    release: PathBuf,
+}
+
+impl Actor {
+    fn start(root: &Path, label: &str, name: &str, sid: &str, action: &str) -> Self {
+        let ready = root.join(format!("{label}-ready"));
+        let release = root.join(format!("{label}-release"));
+        let child = Command::new(std::env::current_exe().expect("test binary"))
+            .args(["--exact", CHILD_TEST, "--nocapture"])
+            .env("CODEX_SETUP_MUTEX_TEST_NAME", name)
+            .env("CODEX_SETUP_MUTEX_TEST_SID", sid)
+            .env("CODEX_SETUP_MUTEX_TEST_READY", &ready)
+            .env("CODEX_SETUP_MUTEX_TEST_RELEASE", &release)
+            .env("CODEX_SETUP_MUTEX_TEST_ACTION", action)
+            .spawn()
+            .expect("spawn mutex actor");
+        let actor = Self { child, release };
+        wait_for_file(&ready);
+        actor
+    }
+
+    fn finish(&mut self) {
+        fs::write(&self.release, b"release").expect("release actor");
+        assert!(self.child.wait().expect("wait actor").success());
+    }
+}
+
+impl Drop for Actor {
+    fn drop(&mut self) {
+        // Never leave a process behind if an assertion fails.
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+fn wait_for_file(path: &Path) {
+    let deadline = Instant::now() + Duration::from_secs(15);
+    while !path.exists() {
+        assert!(
+            Instant::now() < deadline,
+            "actor handshake timeout: {path:?}"
+        );
+        thread::sleep(Duration::from_millis(5));
+    }
+}
+
+fn keep_mutex_alive(name: &str) -> OwnedHandle {
+    let raw = unsafe {
+        OpenMutexW(
+            MUTEX_ALL_ACCESS,
+            /*binherithandle*/ 0,
+            to_wide(name).as_ptr(),
+        )
+    };
+    assert_ne!(raw, 0, "open held mutex: {}", io::Error::last_os_error());
+    unsafe { OwnedHandle::from_raw_handle(raw as _) }
+}
+
+#[test]
+fn setup_mutex_child() {
+    let Ok(name) = std::env::var("CODEX_SETUP_MUTEX_TEST_NAME") else {
+        return;
+    };
+    let sid = std::env::var("CODEX_SETUP_MUTEX_TEST_SID").expect("SID");
+    let ready = std::env::var_os("CODEX_SETUP_MUTEX_TEST_READY").expect("ready");
+    let release = std::env::var_os("CODEX_SETUP_MUTEX_TEST_RELEASE").expect("release");
+    let action = std::env::var("CODEX_SETUP_MUTEX_TEST_ACTION").expect("action");
+    let _guard = if action == "production_mutation" {
+        acquire_setup_mutation_lock(&sid).expect("production helper lock")
+    } else {
+        acquire_named_lock(&name, &sid, /*timeout_ms*/ 5_000).expect("child lock")
+    };
+    fs::write(ready, b"held").expect("ready signal");
+    wait_for_file(Path::new(&release));
+    if action == "abandon" {
+        // Intentionally skips RAII, modeling owner process death.
+        std::process::exit(0);
+    }
+}

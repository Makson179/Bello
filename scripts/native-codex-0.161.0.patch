diff --git a/codex-rs/core/src/session/bello_context_tests.rs b/codex-rs/core/src/session/bello_context_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d9fedd25498445cad52d521313a4471124c23e55
--- /dev/null
+++ b/codex-rs/core/src/session/bello_context_tests.rs
@@ -0,0 +1,442 @@
+//! Fault-injection checks for Bello's checkpoint persistence boundary.
+//! These tests never start a provider request or an external process.
+
+use super::*;
+use codex_features::Feature;
+use codex_history::ResponseItemEnvelope;
+use codex_history::RolloutItem;
+use codex_login::CodexAuth;
+use codex_protocol::ThreadId;
+use codex_protocol::models::BaseInstructions;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::ThreadMemoryMode;
+use codex_thread_store::AppendThreadItemsParams;
+use codex_thread_store::ArchiveThreadParams;
+use codex_thread_store::CreateThreadParams;
+use codex_thread_store::DeleteThreadParams;
+use codex_thread_store::InMemoryThreadStore;
+use codex_thread_store::ListThreadsParams;
+use codex_thread_store::LiveThread;
+use codex_thread_store::LoadThreadHistoryParams;
+use codex_thread_store::PersistContext;
+use codex_thread_store::ReadThreadByRolloutPathParams;
+use codex_thread_store::ReadThreadParams;
+use codex_thread_store::ResumeThreadParams;
+use codex_thread_store::StoredThread;
+use codex_thread_store::StoredThreadHistory;
+use codex_thread_store::ThreadPage;
+use codex_thread_store::ThreadPersistenceMetadata;
+use codex_thread_store::ThreadStore;
+use codex_thread_store::ThreadStoreError;
+use codex_thread_store::ThreadStoreFuture;
+use codex_thread_store::UpdateThreadMetadataParams;
+use serde_json::json;
+use std::any::Any;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use tokio::sync::Notify;
+
+const LATE_RESULT: &str = "late result retained exactly once";
+
+#[derive(Default)]
+struct FaultStore {
+    inner: InMemoryThreadStore,
+    fail_metadata_once: AtomicBool,
+    metadata_failures: AtomicUsize,
+    gate_late_append: AtomicBool,
+    late_append_entered: AtomicBool,
+    release_late_append: Notify,
+    gate_flush: AtomicBool,
+    flush_entered: AtomicBool,
+    release_flush: Notify,
+}
+
+macro_rules! delegate_store_methods {
+    ($(fn $name:ident($param:ident: $params:ty) -> $result:ty;)*) => {
+        $(fn $name(&self, $param: $params) -> ThreadStoreFuture<'_, $result> {
+            ThreadStore::$name(&self.inner, $param)
+        })*
+    };
+}
+
+impl ThreadStore for FaultStore {
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+
+    delegate_store_methods! {
+        fn create_thread(params: CreateThreadParams) -> ();
+        fn resume_thread(params: ResumeThreadParams) -> Arc<Vec<RolloutItem>>;
+        fn discard_thread(thread_id: ThreadId) -> ();
+        fn load_history(params: LoadThreadHistoryParams) -> StoredThreadHistory;
+        fn read_thread(params: ReadThreadParams) -> StoredThread;
+        fn read_thread_by_rollout_path(params: ReadThreadByRolloutPathParams) -> StoredThread;
+        fn list_threads(params: ListThreadsParams) -> ThreadPage;
+        fn update_thread_metadata(params: UpdateThreadMetadataParams) -> Option<StoredThread>;
+        fn archive_thread(params: ArchiveThreadParams) -> ();
+        fn unarchive_thread(params: ArchiveThreadParams) -> StoredThread;
+        fn delete_thread(params: DeleteThreadParams) -> ();
+        fn shutdown_thread(thread_id: ThreadId) -> ();
+    }
+
+    fn append_items(&self, params: AppendThreadItemsParams) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(async move {
+            let has_late_result = params.items.iter().any(|item| {
+                matches!(item, RolloutItem::ResponseItem(envelope)
+                    if serde_json::to_string(&envelope.item).unwrap().contains(LATE_RESULT))
+            });
+            if has_late_result && self.gate_late_append.swap(false, Ordering::SeqCst) {
+                self.late_append_entered.store(true, Ordering::SeqCst);
+                self.release_late_append.notified().await;
+            }
+            ThreadStore::append_items(&self.inner, params).await
+        })
+    }
+
+    fn record_thread_metadata(
+        &self,
+        params: UpdateThreadMetadataParams,
+    ) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(async move {
+            if self.fail_metadata_once.swap(false, Ordering::SeqCst) {
+                self.metadata_failures.fetch_add(1, Ordering::SeqCst);
+                return Err(ThreadStoreError::Internal {
+                    message: "injected metadata failure after accepted append".into(),
+                });
+            }
+            ThreadStore::record_thread_metadata(&self.inner, params).await
+        })
+    }
+
+    fn persist_thread(
+        &self,
+        thread_id: ThreadId,
+        context: PersistContext,
+    ) -> ThreadStoreFuture<'_, ()> {
+        self.inner.persist_thread(thread_id, context)
+    }
+
+    fn flush_thread(&self, thread_id: ThreadId) -> ThreadStoreFuture<'_, ()> {
+        Box::pin(async move {
+            if self.gate_flush.swap(false, Ordering::SeqCst) {
+                self.flush_entered.store(true, Ordering::SeqCst);
+                self.release_flush.notified().await;
+            }
+            self.inner.flush_thread(thread_id).await
+        })
+    }
+}
+
+fn user_message(text: &str) -> ResponseItem {
+    serde_json::from_value(json!({
+        "type": "message", "role": "user",
+        "content": [{"type": "input_text", "text": text}]
+    }))
+    .unwrap()
+}
+
+async fn fixture() -> (
+    Arc<Session>,
+    Arc<TurnContext>,
+    Arc<FaultStore>,
+    async_channel::Receiver<Event>,
+) {
+    let (mut session, turn, rx) =
+        super::tests::make_session_and_context_with_auth_and_config_and_rx(
+            CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+            Vec::new(),
+            |config| {
+                config
+                    .features
+                    .enable(Feature::BelloContextCompaction)
+                    .unwrap();
+            },
+        )
+        .await;
+    let store = Arc::new(FaultStore::default());
+    let config = session.get_config().await;
+    let live = LiveThread::create(
+        store.clone(),
+        CreateThreadParams {
+            creator_user_id: None,
+            creator_account_id: None,
+            session_id: session.session_id(),
+            thread_id: session.thread_id,
+            extra_config: None,
+            forked_from_id: None,
+            parent_thread_id: None,
+            source: SessionSource::Exec,
+            thread_source: None,
+            originator: "bello-context-fault-test".into(),
+            base_instructions: BaseInstructions::default(),
+            dynamic_tools: Vec::new(),
+            selected_capability_roots: Vec::new(),
+            multi_agent_version: None,
+            history_mode: Default::default(),
+            subagent_history_start_ordinal: None,
+            history_base: None,
+            initial_window_id: uuid::Uuid::now_v7().to_string(),
+            runtime_workspace_roots: None,
+            metadata: ThreadPersistenceMetadata {
+                cwd: Some(config.cwd.to_path_buf()),
+                model_provider: config.model_provider_id.clone(),
+                memory_mode: ThreadMemoryMode::Disabled,
+            },
+        },
+    )
+    .await
+    .unwrap();
+    let owned = Arc::get_mut(&mut session).expect("unique fixture session");
+    owned.services.thread_store = store.clone();
+    owned.services.live_thread = Some(live);
+    session
+        .record_conversation_items(&turn, turn.model_info(), &[user_message("original task")])
+        .await;
+    (session, turn, store, rx)
+}
+
+async fn replace(
+    session: &Session,
+    turn: &TurnContext,
+    expected: Vec<ResponseItemEnvelope>,
+    metadata: CompactedHistoryMetadata,
+) -> CodexResult<()> {
+    session
+        .replace_compacted_history_from_snapshot(
+            vec![ResponseItemEnvelope::new(user_message("complete summary"))],
+            Some(turn.to_turn_context_item()),
+            None,
+            metadata,
+            expected,
+            (turn, 100_000),
+        )
+        .await
+}
+
+async fn metadata(session: &Session) -> CompactedHistoryMetadata {
+    let (window_number, window_ids) = session.preview_auto_compact_window().await;
+    CompactedHistoryMetadata {
+        input_goal_ids: Default::default(),
+        message: "complete summary".into(),
+        window_number,
+        window_ids,
+        compaction_response_id: None,
+        compaction_model_hash: None,
+        reviewer_compaction_hash: None,
+    }
+}
+
+#[tokio::test]
+async fn bello_context_accepted_append_metadata_failure_reconciles_without_duplicate() {
+    let (session, turn, store, _rx) = fixture().await;
+    let original = session.clone_history().await.annotated_items().to_vec();
+    let metadata = metadata(&session).await;
+    let expected_window = metadata.window_ids.window_id;
+    store.fail_metadata_once.store(true, Ordering::SeqCst);
+    replace(&session, &turn, original, metadata).await.unwrap();
+
+    assert_eq!(store.metadata_failures.load(Ordering::SeqCst), 1);
+    assert!(
+        !session
+            .state
+            .lock()
+            .await
+            .bello_context_persistence_uncertain
+    );
+    assert_eq!(session.current_window().await.2, expected_window);
+    session.ensure_bello_context_persistence().await.unwrap();
+    assert!(store.inner.calls().await.load_history >= 1);
+    let persisted = session
+        .live_thread()
+        .unwrap()
+        .load_history(false)
+        .await
+        .unwrap();
+    let checkpoints = persisted
+        .items
+        .iter()
+        .filter_map(|item| match item {
+            RolloutItem::Compacted(checkpoint) => Some(checkpoint),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(checkpoints.len(), 1, "reconciliation must not append again");
+    assert_eq!(
+        checkpoints[0].replacement_history.as_deref().unwrap(),
+        session.clone_history().await.annotated_items(),
+    );
+}
+
+#[tokio::test]
+async fn bello_context_late_append_cannot_overtake_checkpoint_persistence() {
+    let (session, turn, store, _rx) = fixture().await;
+    let original = session.clone_history().await.annotated_items().to_vec();
+    let metadata = metadata(&session).await;
+    store.gate_late_append.store(true, Ordering::SeqCst);
+    let late = [user_message(LATE_RESULT)];
+    let mut append = Box::pin(session.record_conversation_items(&turn, turn.model_info(), &late));
+    assert!(futures::poll!(append.as_mut()).is_pending());
+    assert!(store.late_append_entered.load(Ordering::SeqCst));
+    let mut checkpoint = Box::pin(replace(&session, &turn, original, metadata));
+    assert!(futures::poll!(checkpoint.as_mut()).is_pending());
+    let before_release = session
+        .live_thread()
+        .unwrap()
+        .load_history(false)
+        .await
+        .unwrap();
+    assert!(
+        !before_release
+            .items
+            .iter()
+            .any(|item| matches!(item, RolloutItem::Compacted(_)))
+    );
+
+    store.release_late_append.notify_one();
+    tokio::time::timeout(Duration::from_secs(2), append)
+        .await
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(2), checkpoint)
+        .await
+        .unwrap()
+        .unwrap();
+    let persisted = session
+        .live_thread()
+        .unwrap()
+        .load_history(false)
+        .await
+        .unwrap();
+    let checkpoint_index = persisted
+        .items
+        .iter()
+        .position(|item| matches!(item, RolloutItem::Compacted(_)))
+        .unwrap();
+    assert!(persisted.items[..checkpoint_index].iter().any(|item| {
+        matches!(item, RolloutItem::ResponseItem(entry) if serde_json::to_string(&entry.item).unwrap().contains(LATE_RESULT))
+    }));
+    assert!(!persisted.items[checkpoint_index + 1..].iter().any(|item| {
+        matches!(item, RolloutItem::ResponseItem(entry) if serde_json::to_string(&entry.item).unwrap().contains(LATE_RESULT))
+    }), "a late append after its checkpoint would be replayed twice");
+    let RolloutItem::Compacted(checkpoint) = &persisted.items[checkpoint_index] else {
+        unreachable!()
+    };
+    let retained = checkpoint.replacement_history.as_ref().unwrap();
+    assert_eq!(
+        retained
+            .iter()
+            .filter(|entry| serde_json::to_string(&entry.item)
+                .unwrap()
+                .contains(LATE_RESULT))
+            .count(),
+        1
+    );
+    assert_eq!(
+        retained.as_slice(),
+        session.clone_history().await.annotated_items()
+    );
+}
+
+#[tokio::test]
+async fn bello_context_cancellation_during_flush_blocks_later_inference() {
+    let (session, turn, store, _rx) = fixture().await;
+    let original = session.clone_history().await.annotated_items().to_vec();
+    let original_window = session.current_window().await;
+    let metadata = metadata(&session).await;
+    store.gate_flush.store(true, Ordering::SeqCst);
+    let mut checkpoint = Box::pin(replace(&session, &turn, original.clone(), metadata));
+    assert!(futures::poll!(checkpoint.as_mut()).is_pending());
+    assert!(store.flush_entered.load(Ordering::SeqCst));
+    drop(checkpoint); // The same cancellation boundary as an interrupted turn task.
+
+    assert!(
+        session
+            .state
+            .lock()
+            .await
+            .bello_context_persistence_uncertain
+    );
+    assert!(session.ensure_bello_context_persistence().await.is_err());
+    assert_eq!(session.current_window().await, original_window);
+    assert_eq!(
+        session.clone_history().await.annotated_items(),
+        original.as_slice()
+    );
+    let persisted = session
+        .live_thread()
+        .unwrap()
+        .load_history(false)
+        .await
+        .unwrap();
+    assert!(
+        persisted
+            .items
+            .iter()
+            .any(|item| matches!(item, RolloutItem::Compacted(_))),
+        "the store accepted the checkpoint before cancellation; live rollback is not proven"
+    );
+}
+
+#[tokio::test]
+async fn bello_context_cold_resume_requires_complete_checkpoint_companions() {
+    let (session, turn, _store, _rx) = fixture().await;
+    let original = session.clone_history().await.annotated_items().to_vec();
+    replace(&session, &turn, original, metadata(&session).await)
+        .await
+        .unwrap();
+    let persisted = session
+        .live_thread()
+        .unwrap()
+        .load_history(false)
+        .await
+        .unwrap();
+    assert!(Session::bello_checkpoint_complete(&persisted.items));
+    let checkpoint_index = persisted
+        .items
+        .iter()
+        .rposition(|item| matches!(item, RolloutItem::Compacted(_)))
+        .unwrap();
+    let RolloutItem::Compacted(checkpoint) = &persisted.items[checkpoint_index] else {
+        unreachable!()
+    };
+    let expected = checkpoint.replacement_history.as_ref().unwrap()[0]
+        .metadata
+        .as_ref()
+        .unwrap()
+        .bello_checkpoint_companions
+        .as_ref()
+        .unwrap();
+    assert!(!expected.is_empty());
+    for companions_present in 0..expected.len() {
+        assert!(!Session::bello_checkpoint_complete(
+            &persisted.items[..checkpoint_index + 1 + companions_present]
+        ));
+    }
+    let mut mismatched = persisted.items.clone();
+    mismatched[checkpoint_index + 1] =
+        RolloutItem::ResponseItem(user_message("not the expected companion").into());
+    assert!(!Session::bello_checkpoint_complete(&mismatched));
+    let mut interleaved = persisted.items.clone();
+    interleaved.insert(
+        checkpoint_index + 1,
+        RolloutItem::ResponseItem(user_message("interleaved record").into()),
+    );
+    assert!(!Session::bello_checkpoint_complete(&interleaved));
+
+    let (cold, cold_turn, _cold_store, _cold_rx) = fixture().await;
+    let before = cold.clone_history().await.annotated_items().to_vec();
+    assert!(

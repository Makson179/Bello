+    // The turn kept that steer queued. A later batch waits for its own result
+    // instead of returning before its command can finish.
+    let second = gated_call(&queue, BatchId(1), "second").await;
+    let collecting = Arc::clone(&queue);
+    let receiver = activity.subscribe();
+    let waiting = tokio::spawn(async move {
+        collecting

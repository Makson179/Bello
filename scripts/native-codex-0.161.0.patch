+#[test]
+fn inaccessible_existing_mutex_fails_closed() {
+    let sid = current_user_sid().expect("caller SID");
+    let name = format!(r"Local\CodexSetupTest-{}-denied", std::process::id());
+    let mut descriptor = null_mut();
+    let sddl = to_wide("D:P(D;;GA;;;WD)");
+    assert_ne!(
+        unsafe {
+            ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                sddl.as_ptr(),
+                /*stringsdrevision*/ 1,
+                &mut descriptor,
+                null_mut(),
+            )
+        },
+        0
+    );
+    let attributes = SECURITY_ATTRIBUTES {
+        nLength: size_of::<SECURITY_ATTRIBUTES>() as u32,
+        lpSecurityDescriptor: descriptor,
+        bInheritHandle: 0,
+    };
+    let raw = unsafe {
+        CreateMutexW(
+            &attributes,
+            /*binitialowner*/ 0,
+            to_wide(&name).as_ptr(),
+        )
+    };
+    unsafe { LocalFree(descriptor as HLOCAL) };
+    assert_ne!(
+        raw,
+        0,
+        "create denied mutex: {}",
+        io::Error::last_os_error()
+    );
+    let _keeper = unsafe { OwnedHandle::from_raw_handle(raw as _) };
+    let error = acquire_named_lock(&name, &sid, /*timeout_ms*/ 10)
+        .err()
+        .expect("must not bypass denied mutex");
+    assert!(error.to_string().contains("open setup transaction mutex"));
+}

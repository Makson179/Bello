+                rx.await.unwrap();
+                Ok(result("a", "done"))
+            }),
+        )
+        .await;
+    let collecting = Arc::clone(&queue);
+    let task = tokio::spawn(async move { collecting.collect(&CancellationToken::new()).await });
+    tokio::time::advance(GRACE * 4).await;
+    assert!(!task.is_finished());
+    tx.send(()).unwrap();
+    assert_eq!(task.await.unwrap().unwrap(), vec![result("a", "done")]);
+}
+
+#[tokio::test(start_paused = true)]
+async fn ready_result_releases_after_grace_and_late_result_is_append_only() {
+    let queue = AsyncTools::default();
+    let (tx, rx) = oneshot::channel();
+    queue
+        .enqueue(
+            &call("slow"),
+            Box::pin(async move {
+                rx.await.unwrap();
+                Ok(result("slow", "late"))
+            }),
+        )
+        .await;
+    queue
+        .enqueue(
+            &call("fast"),
+            Box::pin(async { Ok(result("fast", "early")) }),
+        )
+        .await;
+    let first = queue.collect(&CancellationToken::new()).await.unwrap();
+    assert_eq!(first.len(), 2);
+    assert_eq!(first[1], result("fast", "early"));
+    let prefix = first.clone();
+    tx.send(()).unwrap();
+    let second = queue.collect(&CancellationToken::new()).await.unwrap();
+    assert_eq!(second, vec![late_output(result("slow", "late")).unwrap()]);
+    assert_eq!(prefix, first);
+    assert!(
+        queue
+            .collect(&CancellationToken::new())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn cancellation_drops_pending_work_and_does_not_deliver_a_result() {
+    let queue = AsyncTools::default();
+    let (tx, rx) = oneshot::channel::<()>();
+    queue
+        .enqueue(
+            &call("a"),
+            Box::pin(async move {
+                rx.await.unwrap();
+                Ok(result("a", "unreachable"))
+            }),
+        )
+        .await;
+    let cancel = CancellationToken::new();
+    cancel.cancel();
+    assert!(queue.collect(&cancel).await.is_err());
+    assert!(tx.is_closed());
+    assert!(
+        queue
+            .collect(&CancellationToken::new())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn real_steer_wakes_wait_without_consuming_the_late_result() {
+    let queue = Arc::new(AsyncTools::default());
+    let (finish, running) = oneshot::channel::<()>();
+    queue
+        .enqueue(
+            &call("slow"),
+            Box::pin(async move {
+                running.await.unwrap();
+                Ok(result("slow", "late"))
+            }),
+        )
+        .await;
+    let (activity, activity_rx) = watch::channel(InputQueueActivity::Mailbox);
+    let collecting = Arc::clone(&queue);
+    let task = tokio::spawn(async move {
+        collecting
+            .collect_with_input(&CancellationToken::new(), Some((activity_rx, false)))
+            .await
+    });
+    tokio::time::advance(GRACE * 4).await;
+    assert!(!task.is_finished());
+    activity.send_replace(InputQueueActivity::Mailbox);
+    tokio::task::yield_now().await;
+    assert!(
+        !task.is_finished(),
+        "Queue-only mail must not wake inference"
+    );
+    activity.send_replace(InputQueueActivity::Steer);
+    let first = task.await.unwrap().unwrap();
+    assert_eq!(first.len(), 1);
+    assert!(!finish.is_closed(), "Steering must not cancel the command");
+    let collecting = Arc::clone(&queue);
+    let second = tokio::spawn(async move { collecting.collect(&CancellationToken::new()).await });
+    tokio::time::advance(GRACE * 4).await;
+    assert!(!second.is_finished());
+    finish.send(()).unwrap();
+    assert_eq!(
+        second.await.unwrap().unwrap(),
+        vec![late_output(result("slow", "late")).unwrap()]
+    );
+    assert!(
+        queue
+            .collect(&CancellationToken::new())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn previously_queued_steer_wakes_without_another_notification() {
+    let queue = AsyncTools::default();
+    let (_finish, running) = oneshot::channel::<()>();
+    queue
+        .enqueue(
+            &call("slow"),
+            Box::pin(async move {
+                running.await.unwrap();
+                Ok(result("slow", "late"))
+            }),
+        )
+        .await;
+    let (_activity, activity_rx) = watch::channel(InputQueueActivity::Steer);
+    let started = Instant::now();
+    let first = queue
+        .collect_with_input(&CancellationToken::new(), Some((activity_rx, true)))
+        .await
+        .unwrap();
+    assert_eq!(first.len(), 1);
+    assert!(started.elapsed() < GRACE);
+    let cancel = CancellationToken::new();
+    cancel.cancel();
+    assert!(queue.collect(&cancel).await.is_err());
+}
+
+#[tokio::test(start_paused = true)]
+async fn cancellation_wins_over_already_ready_output() {
+    let queue = AsyncTools::default();
+    queue
+        .enqueue(
+            &call("ready"),
+            Box::pin(async { Ok(result("ready", "do not deliver")) }),
+        )
+        .await;
+    tokio::task::yield_now().await;
+    let cancel = CancellationToken::new();
+    cancel.cancel();
+    assert!(queue.collect(&cancel).await.is_err());
+    assert!(
+        queue
+            .collect(&CancellationToken::new())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}

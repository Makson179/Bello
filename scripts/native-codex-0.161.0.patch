+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+
+struct ImmediateTool(ToolName);
+
+impl ToolExecutor<ToolInvocation> for ImmediateTool {
+    fn tool_name(&self) -> ToolName {
+        self.0.clone()
+    }
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Function(codex_tools::ResponsesApiTool {
+            name: self.0.name.to_string(),
+            description: "native async gate test".to_string(),
+            strict: false,
+            parameters: codex_tools::JsonSchema::default(),
+            defer_loading: None,
+            output_schema: None,
+        })
+    }
+    fn handle<'a>(&'a self, _: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async {
+            Ok(crate::tools::context::boxed_tool_output(
+                FunctionToolOutput::from_text("done".to_string(), Some(true)),
+            ))
+        })
+    }
+}
+impl CoreToolRuntime for ImmediateTool {}
+
+fn step(mut turn: TurnContext, name: &str) -> Arc<StepContext> {
+    let mut config = (*turn.config).clone();
+    config.features.enable(Feature::BelloAsyncTools).unwrap();
+    turn.config = Arc::new(config);
+    let step = StepContext::for_test(Arc::new(turn));
+    let tool = Arc::new(ImmediateTool(ToolName::plain(name))) as Arc<dyn CoreToolRuntime>;
+    step.with_tool_router_for_test(Arc::new(ToolRouter::from_parts(
+        ToolRegistry::from_tools([tool]),
+        Vec::new(),
+        ToolMode::Direct,
+        BTreeMap::new(),
+        None,
+        &[],
+    )))
+}
+
+fn call(name: &str) -> ToolCall {
+    ToolCall {
+        tool_name: ToolName::plain(name),
+        call_id: "gate-call".to_string(),
+        payload: ToolPayload::Function {
+            arguments: "{}".to_string(),
+        },
+        encrypted_function_args: None,
+    }
+}
+
+#[tokio::test]
+async fn native_async_runtimes_for_the_same_turn_share_the_execution_gate() {
+    let (session, turn) = make_session_and_context().await;
+    let session = Arc::new(session);
+    let step = step(turn, "test_tool");
+    let tracker = Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new()));
+    let first = ToolCallRuntime::new(
+        Arc::clone(&session),
+        Arc::clone(&step),
+        Arc::clone(&tracker),
+    );
+    let second = ToolCallRuntime::new(session, step, tracker);
+    assert!(Arc::ptr_eq(
+        &first.parallel_execution,
+        &second.parallel_execution
+    ));
+}
+
+#[tokio::test]
+async fn native_async_nested_call_uses_its_captured_turn_gate() {
+    let (session, current_turn) = make_session_and_context().await;
+    let (_, originating_turn) = make_session_and_context().await;
+    let current_step = step(current_turn, "test_tool");
+    let originating_step = step(originating_turn, "test_tool");
+    let gate = Arc::clone(
+        &crate::tools::native_async::AsyncTools::for_turn(&originating_step.turn).execution_gate,
+    );
+    let held = gate.write_owned().await;
+    let runtime = ToolCallRuntime::new(
+        Arc::new(session),
+        current_step,
+        Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new())),
+    );
+    let mut task = tokio::spawn(runtime.handle_tool_call_with_source(
+        originating_step,
+        call("test_tool"),
+        ToolCallSource::CodeMode {
+            cell_id: "cell".to_string(),
+            runtime_tool_call_id: "nested".to_string(),
+        },
+        CancellationToken::new(),
+        Arc::default(),
+    ));
+    assert!(
+        tokio::time::timeout(Duration::from_millis(50), &mut task)
+            .await
+            .is_err()
+    );
+    drop(held);
+    tokio::time::timeout(Duration::from_secs(1), task)
+        .await
+        .expect("originating gate release should admit the call")
+        .unwrap()
+        .unwrap();
+}
+
+#[tokio::test]
+async fn native_async_containers_and_child_wait_bypass_the_shared_gate() {
+    for name in ["exec", "wait", "bello_wait_agent"] {
+        let (session, turn) = make_session_and_context().await;
+        let step = step(turn, name);
+        let gate = Arc::clone(
+            &crate::tools::native_async::AsyncTools::for_turn(&step.turn).execution_gate,
+        );
+        let _held = gate.write_owned().await;
+        let runtime = ToolCallRuntime::new(
+            Arc::new(session),
+            step,
+            Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new())),
+        );
+        tokio::time::timeout(
+            Duration::from_secs(1),
+            runtime.handle_tool_call(call(name), CancellationToken::new()),
+        )
+        .await
+        .expect("container must not acquire its nested calls' gate")
+        .unwrap();
+    }
+}

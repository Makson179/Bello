+#[test]
+fn request_metadata_is_fresh_and_does_not_modify_original_payload() {
+    let original = serde_json::json!({
+        "real_user": "ignored-for-lock-identity", "version": crate::setup::SETUP_VERSION
+    });
+    let encoded = BASE64.encode(serde_json::to_vec(&original).expect("serialize"));
+    let first = SetupRequest::begin(&encoded).expect("first request");
+    let decoded: serde_json::Value =
+        serde_json::from_slice(&BASE64.decode(&first.payload_b64).expect("base64")).expect("json");
+    assert_eq!(decoded["setup_lock_sid"], first.sid);
+    assert_eq!(decoded["setup_request_id"], first.request_id);
+    let first_id = first.request_id.clone();
+    drop(first);
+    let second = SetupRequest::begin(&encoded).expect("second request");
+    assert_ne!(first_id, second.request_id);
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(&BASE64.decode(encoded).expect("base64"))
+            .expect("json"),
+        original
+    );
+}

+use super::*;
+use crate::tools::context::ExecCommandToolOutput;
+use codex_tools::ToolName;
+use codex_utils_output_truncation::TruncationPolicy;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn selected_output_forwards_completed_handler_timing() {
+    use std::sync::Arc;
+    use std::sync::atomic::AtomicU64;
+    use std::sync::atomic::Ordering;
+
+    struct TimedOutput(Arc<AtomicU64>);
+    impl ToolOutput for TimedOutput {
+        fn log_output(&self) -> String {
+            String::new()
+        }
+        fn success_for_logging(&self) -> bool {
+            true
+        }
+        fn set_handler_duration_ms(&mut self, duration: u64) {
+            self.0.store(duration, Ordering::Relaxed);
+        }
+        fn to_response_item(&self, call_id: &str, _: &ToolPayload) -> ResponseInputItem {
+            ResponseInputItem::FunctionCallOutput {
+                call_id: call_id.to_string(),
+                output: codex_protocol::models::FunctionCallOutputPayload::from_text(
+                    "Output:\noriginal".to_string(),
+                ),
+            }
+        }
+    }
+    let duration = Arc::new(AtomicU64::new(0));
+    let mut selected = SelectedOutput {
+        original: Box::new(TimedOutput(Arc::clone(&duration))),
+        native: json!({"output": "selected"}),
+        selected: "selected".to_string(),
+    };
+    selected.set_handler_duration_ms(1_234);
+    assert_eq!(duration.load(Ordering::Relaxed), 1_234);
+}
+
+#[test]
+fn native_selection_preserves_host_only_metadata_and_capture_policy() {
+    use crate::tools::context::McpToolOutput;
+    let metadata = json!({"private_key": "HOST_ONLY_METADATA_SENTINEL"});
+    let payload = ToolPayload::Function {
+        arguments: "{}".to_string(),
+    };
+    for capture_allowed in [false, true] {
+        let original = McpToolOutput {
+            result: serde_json::from_value(json!({
+                "content": [{"type":"text", "text":"noise noise noise\nERROR retained\n"}],
+                "_meta": metadata,
+            }))
+            .unwrap(),
+            tool_input: json!({}),
+            result_metadata_capture_allowed: capture_allowed,
+            wall_time: Duration::from_millis(250),
+            original_image_detail_supported: false,
+            truncation_policy: TruncationPolicy::Tokens(10000),
+        };
+        let original: Box<dyn ToolOutput> = Box::new(original);
+        let original_metadata = original.tool_result_metadata().map(std::ptr::from_ref);
+        let selected = SelectedOutput {
+            original,
+            native: json!({"exit_code":0, "output":"ERROR retained\n"}),
+            selected: "ERROR retained\n".to_string(),
+        };
+        assert_eq!(
+            selected.tool_result_metadata(),
+            capture_allowed.then_some(&metadata)
+        );
+        assert_eq!(
+            selected.tool_result_metadata().map(std::ptr::from_ref),
+            original_metadata
+        );
+        let model_outputs = [
+            serde_json::to_string(&selected.to_response_item("call", &payload)).unwrap(),
+            selected.code_mode_result(&payload).to_string(),
+            selected.log_output(),
+        ];

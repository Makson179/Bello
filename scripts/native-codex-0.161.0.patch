+#[cfg(target_os = "windows")]
+#[tokio::test]
+async fn reports_setup_transaction_lock_failure_without_reset() {
+    let home = tempfile::tempdir().expect("create Codex home");
+    codex_windows_sandbox::write_setup_error_report(
+        home.path(),
+        &codex_windows_sandbox::SetupErrorReport {
+            code: codex_windows_sandbox::SetupErrorCode::SetupTransactionLockFailed,
+            message: "setup mutation lock timed out".to_string(),
+            request_id: Some("00112233445566778899aabbccddeeff".to_string()),
+        },
+    )
+    .expect("write synchronization failure");
+    let report_path = codex_windows_sandbox::setup_error_path(home.path());
+    let report_before = std::fs::read(&report_path).expect("read failure before diagnosis");
+    std::fs::write(
+        home.path().join("config.toml"),
+        "[windows]\nsandbox = \"elevated\"\n",
+    )
+    .expect("write elevated sandbox config");
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .build()
+        .await
+        .expect("load sandbox config");
+
+    let check = sandbox_check(&config, &Arg0DispatchPaths::default());
+
+    assert_eq!(check.status, CheckStatus::Fail);
+    insta::assert_snapshot!(serde_json::to_string_pretty(&check.issues).expect("serialize issues"), @r#"
+    [
+      {
+        "severity": "fail",
+        "cause": "elevated Windows sandbox provisioning recorded a structured failure",
+        "measured": "setup_transaction_lock_failed",
+        "expected": null,
+        "remedy": "wait for active sandbox setup to finish; if the failure persists, ask IT to inspect setup synchronization",
+        "fields": [
+          "error code"
+        ]
+      }
+    ]
+    "#);
+    assert_eq!(
+        std::fs::read(report_path).expect("read failure after diagnosis"),
+        report_before
+    );
+}
+

@@ -0,0 +1,408 @@
+//! Experimental local output selection after native execution and policy hooks.
+//! No command execution, approval decisions, history rewriting, or model tools.
+
+use std::net::Ipv4Addr;
+use std::net::SocketAddrV4;
+use std::path::Path;
+use std::time::Duration;
+
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ResponseInputItem;
+use hmac::Hmac;
+use hmac::Mac;
+use serde_json::Value;
+use serde_json::json;
+use sha2::Sha256;
+
+use super::context::ToolInvocation;
+use super::context::ToolOutput;
+use super::context::ToolPayload;
+
+pub(crate) fn focused_spec(
+    mut spec: codex_tools::ToolSpec,
+    enabled: bool,
+) -> codex_tools::ToolSpec {
+    if enabled
+        && let codex_tools::ToolSpec::Function(tool) = &mut spec
+        && let Some(properties) = &mut tool.parameters.properties
+    {
+        properties.insert(
+            "focus".to_string(),
+            codex_tools::JsonSchema::string(Some(
+                "Very short purpose of this command or poll; at most 120 characters.".to_string(),
+            )),
+        );
+    }
+    spec
+}
+
+pub(crate) fn enabled(turn: &crate::session::turn_context::TurnContext) -> bool {
+    cfg!(any(unix, windows))
+        && turn
+            .config
+            .features
+            .enabled(codex_features::Feature::BelloNativeSelection)
+        && !crate::guardian::is_basic_session_source(&turn.session_source)
+}
+
+pub(crate) async fn filter(
+    invocation: &ToolInvocation,
+    original: Box<dyn ToolOutput>,
+) -> Box<dyn ToolOutput> {
+    if !enabled(&invocation.turn) {
+        return original;
+    }
+    if cfg!(windows) {
+        let (Ok(address), Ok(token)) = (
+            std::env::var("BELLO_SELECTOR_TCP"),
+            std::env::var("BELLO_SELECTOR_TOKEN"),
+        ) else {
+            return original;
+        };
+        let Some(endpoint) = TcpSelector::parse(&address, &token) else {
+            return original;
+        };
+        filter_at_endpoint(
+            &invocation.tool_name,
+            &invocation.payload,
+            original,
+            SelectorEndpoint::Tcp(&endpoint),
+        )
+        .await
+    } else {
+        let Some(socket) = std::env::var_os("BELLO_SELECTOR_SOCKET") else {
+            return original;
+        };
+        filter_at_socket(
+            &invocation.tool_name,
+            &invocation.payload,
+            original,
+            Path::new(&socket),
+        )
+        .await
+    }
+}
+
+async fn filter_at_socket(
+    tool_name: &codex_tools::ToolName,
+    payload: &ToolPayload,
+    original: Box<dyn ToolOutput>,
+    socket: &Path,
+) -> Box<dyn ToolOutput> {
+    if !socket.is_absolute() {
+        return original;
+    }
+    filter_at_endpoint(tool_name, payload, original, SelectorEndpoint::Unix(socket)).await
+}
+
+enum SelectorEndpoint<'a> {
+    Unix(&'a Path),
+    Tcp(&'a TcpSelector),
+}
+
+struct TcpSelector {
+    address: SocketAddrV4,
+    token: [u8; 32],
+}
+
+impl TcpSelector {
+    fn parse(address: &str, token: &str) -> Option<Self> {
+        // No DNS, IPv6, non-loopback addresses, userinfo or alternate spellings.
+        let port = address.strip_prefix("127.0.0.1:")?;
+        if port.is_empty() || !port.bytes().all(|byte| byte.is_ascii_digit()) {
+            return None;
+        }
+        let port = port.parse::<u16>().ok().filter(|port| *port != 0)?;
+        Some(Self {
+            address: SocketAddrV4::new(Ipv4Addr::LOCALHOST, port),
+            token: decode_hex32(token)?,
+        })
+    }
+}
+
+fn decode_hex32(value: &str) -> Option<[u8; 32]> {
+    if value.len() != 64
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return None;
+    }
+    let mut bytes = [0; 32];
+    for (index, slot) in bytes.iter_mut().enumerate() {
+        *slot = u8::from_str_radix(&value[index * 2..index * 2 + 2], 16).ok()?;
+    }
+    Some(bytes)
+}
+
+fn encode_hex32(value: &[u8]) -> String {
+    value.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+fn authentication_mac(
+    token: &[u8; 32],
+    domain: &[u8],
+    client_nonce: &str,
+    server_nonce: &str,
+) -> Hmac<Sha256> {
+    let mut mac = Hmac::<Sha256>::new_from_slice(token).expect("HMAC accepts a 32-byte key");
+    mac.update(domain);
+    mac.update(client_nonce.as_bytes());
+    mac.update(server_nonce.as_bytes());
+    mac
+}
+
+async fn filter_at_endpoint(
+    tool_name: &codex_tools::ToolName,
+    payload: &ToolPayload,
+    original: Box<dyn ToolOutput>,
+    endpoint: SelectorEndpoint<'_>,
+) -> Box<dyn ToolOutput> {
+    if !tool_name.is_default_namespace()
+        || !matches!(tool_name.name.as_str(), "exec_command" | "write_stdin")
+    {
+        return original;
+    }
+    let ToolPayload::Function { arguments } = payload else {
+        return original;
+    };
+    let Ok(arguments) = serde_json::from_str::<Value>(arguments) else {
+        return original;
+    };
+    let Some(focus) = arguments
+        .get("focus")
+        .and_then(Value::as_str)
+        .filter(|focus| !focus.trim().is_empty() && focus.chars().count() <= 120)
+    else {
+        return original;
+    };
+    // write_stdin outputs retain the real original command here, including polls
+    // whose process is still running.
+    // Missing association is a pass-through, never an invented empty command.
+    let Some(input) = original.post_tool_use_input(payload) else {
+        return original;
+    };
+    let Some(command) = input.get("command").and_then(Value::as_str) else {
+        return original;
+    };
+    let mut native = original.code_mode_result(payload);
+    let Some(raw) = native.get("output").and_then(Value::as_str) else {
+        return original;
+    };
+    if raw.is_empty() {
+        return original;
+    }
+    let request = json!({"focus": focus, "command": command, "log": raw});
+    let max_response_bytes = raw.len().saturating_mul(6).saturating_add(1024);
+    let Ok(Some(selected)) = tokio::time::timeout(
+        Duration::from_secs(315),
+        exchange_endpoint(endpoint, request, max_response_bytes),
+    )
+    .await
+    else {
+        return original;
+    };
+    if selected.len() >= raw.len() {
+        return original;
+    }
+    native["output"] = Value::String(selected.clone());
+    Box::new(SelectedOutput {
+        original,
+        native,
+        selected,
+    })
+}
+
+async fn exchange_endpoint(
+    endpoint: SelectorEndpoint<'_>,
+    request: Value,
+    max_bytes: usize,
+) -> Option<String> {
+    match endpoint {
+        SelectorEndpoint::Unix(socket) => exchange(socket, request, max_bytes).await,
+        SelectorEndpoint::Tcp(endpoint) => exchange_tcp(endpoint, request, max_bytes).await,
+    }
+}
+
+async fn send_record<S: tokio::io::AsyncWrite + Unpin>(
+    stream: &mut S,
+    value: &Value,
+) -> Option<()> {
+    use tokio::io::AsyncWriteExt;
+    let mut encoded = serde_json::to_vec(value).ok()?;
+    encoded.push(b'\n');
+    stream.write_all(&encoded).await.ok()
+}
+
+async fn read_record<S: tokio::io::AsyncRead + Unpin>(
+    stream: &mut S,
+    max_bytes: usize,
+) -> Option<Value> {
+    use tokio::io::AsyncReadExt;
+    let mut received = Vec::new();
+    let mut buffer = [0_u8; 8192];
+    loop {
+        let count = stream.read(&mut buffer).await.ok()?;
+        if count == 0 || received.len().saturating_add(count) > max_bytes {
+            return None;
+        }
+        received.extend_from_slice(&buffer[..count]);
+        if let Some(end) = received.iter().position(|byte| *byte == b'\n') {
+            if !received[end + 1..].iter().all(u8::is_ascii_whitespace) {
+                return None;
+            }
+            return serde_json::from_slice(&received[..end]).ok();
+        }
+    }
+}
+
+async fn exchange_tcp(
+    endpoint: &TcpSelector,
+    mut request: Value,
+    max_bytes: usize,
+) -> Option<String> {
+    // Authenticate the listener before disclosing command output. A bare bearer
+    // token would leak the log to a process that rebound a stale loopback port.
+    let (mut stream, auth) = tokio::time::timeout(Duration::from_secs(5), async {
+        let mut stream = tokio::net::TcpStream::connect(endpoint.address)
+            .await
+            .ok()?;
+        let client_nonce = encode_hex32(&rand::random::<[u8; 32]>());
+        send_record(&mut stream, &json!({"version": 1, "nonce": client_nonce})).await?;
+        let challenge = read_record(&mut stream, 1024).await?;
+        let server_nonce = challenge.get("nonce")?.as_str()?;
+        decode_hex32(server_nonce)?;
+        let proof = decode_hex32(challenge.get("proof")?.as_str()?)?;
+        authentication_mac(
+            &endpoint.token,
+            b"bello-selector-server-v1\0",
+            &client_nonce,
+            server_nonce,
+        )
+        .verify_slice(&proof)
+        .ok()?;
+        let auth = authentication_mac(
+            &endpoint.token,
+            b"bello-selector-client-v1\0",
+            &client_nonce,
+            server_nonce,
+        )
+        .finalize()
+        .into_bytes();
+        Some((stream, encode_hex32(&auth)))
+    })
+    .await
+    .ok()??;
+    request
+        .as_object_mut()?
+        .insert("auth".to_string(), Value::String(auth));
+    send_record(&mut stream, &request).await?;
+    read_record(&mut stream, max_bytes)
+        .await?
+        .get("text")?
+        .as_str()
+        .map(str::to_string)
+}
+
+#[cfg(unix)]
+async fn exchange(socket: &Path, request: Value, max_bytes: usize) -> Option<String> {
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+    let mut stream = tokio::net::UnixStream::connect(socket).await.ok()?;
+    let mut encoded = serde_json::to_vec(&request).ok()?;
+    encoded.push(b'\n');
+    stream.write_all(&encoded).await.ok()?;
+    let mut received = Vec::new();
+    let mut buffer = [0_u8; 8192];
+    loop {
+        let count = stream.read(&mut buffer).await.ok()?;
+        if count == 0 || received.len().saturating_add(count) > max_bytes {
+            return None;
+        }
+        received.extend_from_slice(&buffer[..count]);
+        if let Some(end) = received.iter().position(|byte| *byte == b'\n') {
+            if !received[end + 1..].iter().all(u8::is_ascii_whitespace) {
+                return None;
+            }
+            let response: Value = serde_json::from_slice(&received[..end]).ok()?;
+            return response
+                .get("text")
+                .and_then(Value::as_str)
+                .map(str::to_string);
+        }
+    }
+}
+
+#[cfg(not(unix))]
+async fn exchange(_socket: &Path, _request: Value, _max_bytes: usize) -> Option<String> {
+    None
+}
+
+struct SelectedOutput {
+    original: Box<dyn ToolOutput>,
+    native: Value,
+    selected: String,
+}
+
+impl ToolOutput for SelectedOutput {
+    fn log_output(&self) -> String {
+        self.original.log_output()
+    }
+    fn success_for_logging(&self) -> bool {
+        self.original.success_for_logging()
+    }
+    fn set_handler_duration_ms(&mut self, handler_duration_ms: u64) {
+        self.original.set_handler_duration_ms(handler_duration_ms);
+    }
+    fn fallback_token_limit_override(&self) -> Option<usize> {
+        self.original.fallback_token_limit_override()
+    }
+    fn tool_result_metadata(&self) -> Option<&Value> {
+        self.original.tool_result_metadata()
+    }
+    fn contains_external_context(&self) -> bool {
+        self.original.contains_external_context()
+    }
+    fn post_tool_use_id(&self, call_id: &str) -> String {
+        self.original.post_tool_use_id(call_id)
+    }
+    fn post_tool_use_input(&self, payload: &ToolPayload) -> Option<Value> {
+        self.original.post_tool_use_input(payload)
+    }
+    fn post_tool_use_response(&self, call_id: &str, payload: &ToolPayload) -> Option<Value> {
+        self.original.post_tool_use_response(call_id, payload)
+    }
+    fn code_mode_result(&self, _payload: &ToolPayload) -> Value {
+        self.native.clone()
+    }
+    fn to_response_item(&self, call_id: &str, payload: &ToolPayload) -> ResponseInputItem {
+        let mut response = self.original.to_response_item(call_id, payload);
+        let replace = |text: &mut String| {
+            // Native unified-exec formatting owns this separator. Preserve its
+            // metadata prefix byte-for-byte and never enlarge its direct cap.
+            if let Some((prefix, output)) = text.split_once("\nOutput:\n")
+                && self.selected.len() < output.len()
+            {
+                *text = format!("{prefix}\nOutput:\n{}", self.selected);
+            }
+        };
+        if let ResponseInputItem::FunctionCallOutput { output, .. } = &mut response {
+            match &mut output.body {
+                FunctionCallOutputBody::Text(text) => replace(text),
+                FunctionCallOutputBody::ContentItems(items) => {
+                    for item in items {
+                        if let FunctionCallOutputContentItem::InputText { text } = item {
+                            replace(text);
+                        }
+                    }
+                }
+            }
+        }
+        response
+    }
+}
+

+use super::*;
+use crate::tools::context::ExecCommandToolOutput;
+use codex_tools::ToolName;
+use codex_utils_output_truncation::TruncationPolicy;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn native_selection_preserves_host_only_metadata_and_capture_policy() {
+    use crate::tools::context::McpToolOutput;
+    let metadata = json!({"private_key": "HOST_ONLY_METADATA_SENTINEL"});
+    let payload = ToolPayload::Function {
+        arguments: "{}".to_string(),
+    };
+    for capture_allowed in [false, true] {
+        let original = McpToolOutput {
+            result: serde_json::from_value(json!({
+                "content": [{"type":"text", "text":"noise noise noise\nERROR retained\n"}],
+                "_meta": metadata,
+            }))
+            .unwrap(),
+            tool_input: json!({}),
+            result_metadata_capture_allowed: capture_allowed,
+            wall_time: Duration::from_millis(250),
+            original_image_detail_supported: false,
+            truncation_policy: TruncationPolicy::Tokens(10000),
+        };
+        let original: Box<dyn ToolOutput> = Box::new(original);
+        let original_metadata = original.tool_result_metadata().map(std::ptr::from_ref);
+        let selected = SelectedOutput {
+            original,
+            native: json!({"exit_code":0, "output":"ERROR retained\n"}),
+            selected: "ERROR retained\n".to_string(),
+        };
+        assert_eq!(
+            selected.tool_result_metadata(),
+            capture_allowed.then_some(&metadata)
+        );
+        assert_eq!(
+            selected.tool_result_metadata().map(std::ptr::from_ref),
+            original_metadata
+        );
+        let model_outputs = [
+            serde_json::to_string(&selected.to_response_item("call", &payload)).unwrap(),
+            selected.code_mode_result(&payload).to_string(),
+            selected.log_output(),
+        ];
+        for text in model_outputs {
+            assert!(!text.contains("HOST_ONLY_METADATA_SENTINEL"));
+        }
+    }
+}
+
+#[test]
+fn native_selection_focus_only_changes_optional_input_property() {
+    use crate::tools::handlers::shell_spec::CommandToolOptions;
+    use crate::tools::handlers::shell_spec::create_exec_command_tool;
+    use crate::tools::handlers::shell_spec::create_write_stdin_tool;
+    for original in [
+        create_exec_command_tool(CommandToolOptions {
+            allow_login_shell: true,
+            exec_permission_approvals_enabled: true,
+        }),
+        create_write_stdin_tool(),
+    ] {
+        assert_eq!(focused_spec(original.clone(), false), original);
+        let mut selected = focused_spec(original.clone(), true);
+        let codex_tools::ToolSpec::Function(function) = &mut selected else {
+            panic!("expected native command function");
+        };
+        let focus = function
+            .parameters
+            .properties
+            .as_mut()
+            .unwrap()
+            .remove("focus");
+        assert!(focus.is_some());
+        assert_eq!(selected, original);
+    }
+}
+
+fn output(process_id: Option<i32>) -> Box<dyn ToolOutput> {
+    Box::new(ExecCommandToolOutput {
+        event_call_id: "native-call".to_string(),
+        chunk_id: "chunk-123".to_string(),
+        wall_time: Duration::from_millis(250),
+        raw_output: b"noise noise noise\nERROR retained\n".to_vec(),
+        truncation_policy: TruncationPolicy::Tokens(10000),
+        max_output_tokens: Some(10000),
+        process_id,
+        exit_code: process_id.is_none().then_some(7),
+        original_token_count: Some(9),
+        output_omitted_bytes: None,
+        hook_command: Some("actual original command".to_string()),
+    })
+}
+
+#[tokio::test]
+#[cfg(unix)]
+async fn native_selection_preserves_metadata_and_poll_command() {
+    use tokio::io::AsyncBufReadExt;
+    use tokio::io::AsyncWriteExt;
+    for (name, process_id) in [
+        ("exec_command", None),
+        ("write_stdin", None),
+        ("exec_command", Some(123)),
+        ("write_stdin", Some(123)),
+    ] {
+        let directory = tempfile::tempdir().unwrap();
+        let socket = directory.path().join("selector.sock");
+        let listener = tokio::net::UnixListener::bind(&socket).unwrap();
+        let peer = tokio::spawn(async move {
+            let (mut connection, _) = listener.accept().await.unwrap();
+            let mut request = String::new();
+            tokio::io::BufReader::new(&mut connection)
+                .read_line(&mut request)
+                .await
+                .unwrap();
+            assert_eq!(
+                serde_json::from_str::<Value>(&request).unwrap(),
+                json!({
+                "focus": "inspect test failure", "command": "actual original command",
+                "log": "noise noise noise\nERROR retained\n"})
+            );
+            connection
+                .write_all(b"{\"text\":\"ERROR retained\\n\"}\n")
+                .await
+                .unwrap();
+        });
+        let payload = ToolPayload::Function {
+            arguments: json!({"focus":"inspect test failure"}).to_string(),
+        };
+        let original = output(process_id);
+        let mut expected = original.code_mode_result(&payload);
+        expected["output"] = json!("ERROR retained\n");
+        let selected = filter_at_socket(&ToolName::plain(name), &payload, original, &socket).await;
+        assert_eq!(selected.code_mode_result(&payload), expected);
+        let native = output(process_id).to_response_item("call", &payload);
+        let mut expected_direct = native.clone();
+        if let ResponseInputItem::FunctionCallOutput { output, .. } = &mut expected_direct
+            && let FunctionCallOutputBody::Text(text) = &mut output.body
+        {
+            *text = text.replace("noise noise noise\nERROR retained\n", "ERROR retained\n");
+        } else {
+            panic!("native single-text output must use a text body");
+        }
+        assert_eq!(selected.to_response_item("call", &payload), expected_direct);
+        peer.await.unwrap();
+    }
+}
+
+#[tokio::test]
+async fn absent_backend_and_missing_focus_preserve_original() {
+    for (focus, process_id) in [
+        (Some("inspect output"), Some(123)),
+        (None, None),
+        (Some("inspect output"), None),
+    ] {
+        let payload = ToolPayload::Function {
+            arguments: json!({"focus": focus}).to_string(),
+        };
+        let original = output(process_id);
+        let expected = original.code_mode_result(&payload);
+        let selected = filter_at_socket(
+            &ToolName::plain("exec_command"),
+            &payload,
+            original,
+            Path::new("/nonexistent/bello-selector.sock"),
+        )
+        .await;
+        assert_eq!(selected.code_mode_result(&payload), expected);
+    }
+}

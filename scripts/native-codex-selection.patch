+#[test]
+fn mutex_excludes_other_process_until_owner_finishes() {
+    let root = tempfile::tempdir().expect("tempdir");
+    let sid = current_user_sid().expect("caller SID");
+    let name = format!(r"Local\CodexSetupTest-{}-exclusion", std::process::id());
+    let mut owner = Actor::start(root.path(), "owner", &name, &sid, "release");
+    let error = acquire_named_lock(&name, &sid, /*timeout_ms*/ 10)
+        .err()
+        .expect("must exclude");
+    assert!(error.to_string().contains("timed out"));
+    owner.finish();
+    let _guard = acquire_named_lock(&name, &sid, /*timeout_ms*/ 1_000).expect("released lock");
+}
+
+#[test]
+fn abandoned_mutex_fails_closed_and_releases_granted_ownership() {
+    let root = tempfile::tempdir().expect("tempdir");
+    let sid = current_user_sid().expect("caller SID");
+    let name = format!(r"Local\CodexSetupTest-{}-abandon", std::process::id());
+    let mut owner = Actor::start(root.path(), "owner", &name, &sid, "abandon");
+    let _keeper = keep_mutex_alive(&name);
+    owner.finish();
+    let error = acquire_named_lock(&name, &sid, /*timeout_ms*/ 1_000)
+        .err()
+        .expect("abandoned");
+    assert!(error.to_string().contains("abandoned"));
+    let mut successor = Actor::start(root.path(), "successor", &name, &sid, "release");
+    successor.finish();
+}
+
+#[test]
+fn helper_mutation_lock_survives_parent_request_owner_death() {
+    let root = tempfile::tempdir().expect("tempdir");
+    let sid = current_user_sid().expect("caller SID");
+    let request_name = format!(r"Local\CodexSetupTest-{}-orphan-A", std::process::id());
+    let mutation_name = format!(r"Local\CodexSetupTest-{}-orphan-B", std::process::id());
+    let mut parent = Actor::start(root.path(), "parent", &request_name, &sid, "abandon");
+    let _keeper = keep_mutex_alive(&request_name);
+    let mut helper = Actor::start(root.path(), "helper", &mutation_name, &sid, "release");
+    parent.finish();
+    assert!(acquire_named_lock(&request_name, &sid, /*timeout_ms*/ 1_000).is_err());
+    let _next_request =
+        acquire_named_lock(&request_name, &sid, /*timeout_ms*/ 1_000).expect("next parent request");
+    let error = acquire_named_lock(&mutation_name, &sid, /*timeout_ms*/ 10)
+        .err()
+        .expect("surviving helper must still exclude mutations");
+    assert!(error.to_string().contains("timed out"));
+    helper.finish();
+    let _mutation =
+        acquire_named_lock(&mutation_name, &sid, /*timeout_ms*/ 1_000).expect("helper completed");
+}

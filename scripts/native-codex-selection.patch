+#[tokio::test]
+#[cfg(unix)]
+async fn native_selection_accepts_response_after_three_hundred_seconds() {
+    use tokio::io::AsyncBufReadExt;
+    use tokio::io::AsyncWriteExt;
+    let directory = tempfile::tempdir().unwrap();
+    let socket = directory.path().join("selector.sock");
+    let listener = tokio::net::UnixListener::bind(&socket).unwrap();
+    let peer = tokio::spawn(async move {
+        let (mut connection, _) = listener.accept().await.unwrap();
+        let mut request = String::new();
+        tokio::io::BufReader::new(&mut connection)
+            .read_line(&mut request)
+            .await
+            .unwrap();
+        // The request has reached the peer, so the native transport timer is
+        // active. Advance only this test runtime, without a real five-minute wait.
+        tokio::time::pause();
+        tokio::time::advance(Duration::from_secs(301)).await;
+        tokio::task::yield_now().await;
+        tokio::time::resume();
+        connection
+            .write_all(b"{\"text\":\"ERROR retained\\n\"}\n")
+            .await
+            .unwrap();
+    });
+    let payload = ToolPayload::Function {
+        arguments: json!({"focus":"inspect output"}).to_string(),
+    };
+    let original = output(/*process_id*/ None);
+    let mut expected = original.code_mode_result(&payload);
+    expected["output"] = json!("ERROR retained\n");
+    let selected = filter_at_socket(
+        &ToolName::plain("exec_command"),
+        &payload,
+        original,
+        &socket,

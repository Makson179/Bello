+            allow_login_shell: true,
+            exec_permission_approvals_enabled: true,
+        }),
+        create_write_stdin_tool(),
+    ] {
+        assert_eq!(focused_spec(original.clone(), false), original);
+        let mut selected = focused_spec(original.clone(), true);
+        let codex_tools::ToolSpec::Function(function) = &mut selected else {
+            panic!("expected native command function");
+        };
+        let focus = function
+            .parameters
+            .properties
+            .as_mut()
+            .unwrap()
+            .remove("focus");

@@ -0,0 +1,286 @@
+use super::*;
+use codex_tools::ToolName;
+use pretty_assertions::assert_eq;
+use tokio::sync::oneshot;
+
+fn call(id: &str) -> ToolCall {
+    ToolCall {
+        tool_name: ToolName::plain("exec_command"),
+        call_id: id.to_string(),
+        payload: ToolPayload::Function {
+            arguments: "{}".to_string(),
+        },
+        encrypted_function_args: None,
+    }
+}
+fn result(id: &str, text: &str) -> ResponseItemEnvelope {
+    ResponseItemEnvelope::new(
+        ResponseInputItem::FunctionCallOutput {
+            call_id: id.to_string(),
+            output: FunctionCallOutputPayload::from_text(text.to_string()),
+        }
+        .into(),
+    )
+}
+
+#[test]
+fn late_results_preserve_media_without_resolving_a_call_twice() {
+    let envelope = ResponseItemEnvelope::new(
+        ResponseInputItem::FunctionCallOutput {
+            call_id: "a".to_string(),
+            output: FunctionCallOutputPayload::from_content_items(vec![
+                FunctionCallOutputContentItem::InputText {
+                    text: "diagnostic".to_string(),
+                },
+                FunctionCallOutputContentItem::InputImage {
+                    image_url: "data:image/png;base64,cGl4ZWw=".to_string(),
+                    detail: None,
+                },
+                FunctionCallOutputContentItem::InputAudio {
+                    audio_url: "data:audio/wav;base64,YXVkaW8=".to_string(),
+                },
+            ]),
+        }
+        .into(),
+    );
+    let ResponseItem::Message { role, content, .. } = late_output(envelope).unwrap().item else {
+        panic!("late output must be a data message, not a duplicate function resolution");
+    };
+    assert_eq!(role, "user");
+    assert_eq!(
+        content[1],
+        ContentItem::InputText {
+            text: "diagnostic".to_string()
+        }
+    );
+    assert!(
+        matches!(&content[2], ContentItem::InputImage { image_url, .. } if image_url == "data:image/png;base64,cGl4ZWw=")
+    );
+    assert!(
+        matches!(&content[3], ContentItem::InputAudio { audio_url } if audio_url == "data:audio/wav;base64,YXVkaW8=")
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn failed_tool_settles_all_other_wrappers_before_returning_error() {
+    let queue = AsyncTools::default();
+    let (tx, rx) = oneshot::channel::<()>();
+    queue
+        .enqueue(
+            &call("slow"),
+            Box::pin(async move {
+                rx.await.unwrap();
+                Ok(result("slow", "unreachable"))
+            }),
+        )
+        .await;
+    queue
+        .enqueue(
+            &call("failed"),
+            Box::pin(async { Err(CodexErr::Fatal("synthetic async error".to_string())) }),
+        )
+        .await;
+    let error = queue.collect(&CancellationToken::new()).await.unwrap_err();
+    assert!(error.to_string().contains("synthetic async error"));
+    assert!(tx.is_closed());
+    assert!(
+        queue
+            .collect(&CancellationToken::new())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn all_done_returns_before_grace_without_pending_markers() {
+    let queue = AsyncTools::default();
+    queue
+        .enqueue(&call("a"), Box::pin(async { Ok(result("a", "done")) }))
+        .await;
+    let started = Instant::now();
+    let outputs = queue.collect(&CancellationToken::new()).await.unwrap();
+    assert_eq!(outputs, vec![result("a", "done")]);
+    assert!(started.elapsed() < GRACE);
+}
+
+#[tokio::test(start_paused = true)]
+async fn grace_does_not_wake_for_an_unfinished_only_call() {
+    let queue = Arc::new(AsyncTools::default());
+    let (tx, rx) = oneshot::channel();
+    queue
+        .enqueue(
+            &call("a"),
+            Box::pin(async move {
+                rx.await.unwrap();
+                Ok(result("a", "done"))
+            }),
+        )
+        .await;
+    let collecting = Arc::clone(&queue);
+    let task = tokio::spawn(async move { collecting.collect(&CancellationToken::new()).await });
+    tokio::time::advance(GRACE * 4).await;
+    assert!(!task.is_finished());
+    tx.send(()).unwrap();
+    assert_eq!(task.await.unwrap().unwrap(), vec![result("a", "done")]);
+}
+
+#[tokio::test(start_paused = true)]
+async fn ready_result_releases_after_grace_and_late_result_is_append_only() {
+    let queue = AsyncTools::default();
+    let (tx, rx) = oneshot::channel();
+    queue
+        .enqueue(
+            &call("slow"),
+            Box::pin(async move {
+                rx.await.unwrap();
+                Ok(result("slow", "late"))
+            }),
+        )
+        .await;
+    queue
+        .enqueue(
+            &call("fast"),
+            Box::pin(async { Ok(result("fast", "early")) }),
+        )
+        .await;
+    let first = queue.collect(&CancellationToken::new()).await.unwrap();
+    assert_eq!(first.len(), 2);
+    assert_eq!(first[1], result("fast", "early"));
+    let prefix = first.clone();
+    tx.send(()).unwrap();
+    let second = queue.collect(&CancellationToken::new()).await.unwrap();
+    assert_eq!(second, vec![late_output(result("slow", "late")).unwrap()]);
+    assert_eq!(prefix, first);
+    assert!(
+        queue
+            .collect(&CancellationToken::new())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn cancellation_drops_pending_work_and_does_not_deliver_a_result() {
+    let queue = AsyncTools::default();
+    let (tx, rx) = oneshot::channel::<()>();
+    queue
+        .enqueue(
+            &call("a"),
+            Box::pin(async move {
+                rx.await.unwrap();
+                Ok(result("a", "unreachable"))
+            }),
+        )
+        .await;
+    let cancel = CancellationToken::new();
+    cancel.cancel();
+    assert!(queue.collect(&cancel).await.is_err());
+    assert!(tx.is_closed());
+    assert!(
+        queue
+            .collect(&CancellationToken::new())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn real_steer_wakes_wait_without_consuming_the_late_result() {
+    let queue = Arc::new(AsyncTools::default());
+    let (finish, running) = oneshot::channel::<()>();
+    queue
+        .enqueue(
+            &call("slow"),
+            Box::pin(async move {
+                running.await.unwrap();
+                Ok(result("slow", "late"))
+            }),
+        )
+        .await;
+    let (activity, activity_rx) = watch::channel(InputQueueActivity::Mailbox);
+    let collecting = Arc::clone(&queue);
+    let task = tokio::spawn(async move {
+        collecting
+            .collect_with_input(&CancellationToken::new(), Some((activity_rx, false)))
+            .await
+    });
+    tokio::time::advance(GRACE * 4).await;
+    assert!(!task.is_finished());
+    activity.send_replace(InputQueueActivity::Mailbox);
+    tokio::task::yield_now().await;
+    assert!(
+        !task.is_finished(),
+        "Queue-only mail must not wake inference"
+    );
+    activity.send_replace(InputQueueActivity::Steer);
+    let first = task.await.unwrap().unwrap();
+    assert_eq!(first.len(), 1);
+    assert!(!finish.is_closed(), "Steering must not cancel the command");
+    let collecting = Arc::clone(&queue);
+    let second = tokio::spawn(async move { collecting.collect(&CancellationToken::new()).await });
+    tokio::time::advance(GRACE * 4).await;
+    assert!(!second.is_finished());
+    finish.send(()).unwrap();
+    assert_eq!(
+        second.await.unwrap().unwrap(),
+        vec![late_output(result("slow", "late")).unwrap()]
+    );
+    assert!(
+        queue
+            .collect(&CancellationToken::new())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn previously_queued_steer_wakes_without_another_notification() {
+    let queue = AsyncTools::default();
+    let (_finish, running) = oneshot::channel::<()>();
+    queue
+        .enqueue(
+            &call("slow"),
+            Box::pin(async move {
+                running.await.unwrap();
+                Ok(result("slow", "late"))
+            }),
+        )
+        .await;
+    let (_activity, activity_rx) = watch::channel(InputQueueActivity::Steer);
+    let started = Instant::now();
+    let first = queue
+        .collect_with_input(&CancellationToken::new(), Some((activity_rx, true)))
+        .await
+        .unwrap();
+    assert_eq!(first.len(), 1);
+    assert!(started.elapsed() < GRACE);
+    let cancel = CancellationToken::new();
+    cancel.cancel();
+    assert!(queue.collect(&cancel).await.is_err());
+}
+
+#[tokio::test(start_paused = true)]
+async fn cancellation_wins_over_already_ready_output() {
+    let queue = AsyncTools::default();
+    queue
+        .enqueue(
+            &call("ready"),
+            Box::pin(async { Ok(result("ready", "do not deliver")) }),
+        )
+        .await;
+    tokio::task::yield_now().await;
+    let cancel = CancellationToken::new();
+    cancel.cancel();
+    assert!(queue.collect(&cancel).await.is_err());
+    assert!(
+        queue
+            .collect(&CancellationToken::new())
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}

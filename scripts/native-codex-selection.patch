+#[tokio::test]
+#[cfg(unix)]
+async fn native_selection_preserves_metadata_and_poll_command() {
+    use tokio::io::AsyncBufReadExt;
+    use tokio::io::AsyncWriteExt;
+    for (name, process_id) in [
+        ("exec_command", None),
+        ("write_stdin", None),
+        ("exec_command", Some(123)),
+        ("write_stdin", Some(123)),
+    ] {
+        let directory = tempfile::tempdir().unwrap();
+        let socket = directory.path().join("selector.sock");
+        let listener = tokio::net::UnixListener::bind(&socket).unwrap();
+        let peer = tokio::spawn(async move {
+            let (mut connection, _) = listener.accept().await.unwrap();
+            let mut request = String::new();
+            tokio::io::BufReader::new(&mut connection)
+                .read_line(&mut request)
+                .await
+                .unwrap();
+            assert_eq!(
+                serde_json::from_str::<Value>(&request).unwrap(),
+                json!({
+                "focus": "inspect test failure", "command": "actual original command",
+                "log": "noise noise noise\nERROR retained\n"})
+            );
+            connection
+                .write_all(b"{\"text\":\"ERROR retained\\n\"}\n")
+                .await
+                .unwrap();
+        });
+        let payload = ToolPayload::Function {
+            arguments: json!({"focus":"inspect test failure"}).to_string(),
+        };
+        let original = output(process_id);
+        let mut expected = original.code_mode_result(&payload);
+        expected["output"] = json!("ERROR retained\n");
+        let selected = filter_at_socket(&ToolName::plain(name), &payload, original, &socket).await;
+        assert_eq!(selected.code_mode_result(&payload), expected);
+        let native = output(process_id).to_response_item("call", &payload);
+        let mut expected_direct = native.clone();
+        if let ResponseInputItem::FunctionCallOutput { output, .. } = &mut expected_direct
+            && let FunctionCallOutputBody::Text(text) = &mut output.body
+        {
+            *text = text.replace("noise noise noise\nERROR retained\n", "ERROR retained\n");
+        } else {
+            panic!("native single-text output must use a text body");
+        }
+        assert_eq!(selected.to_response_item("call", &payload), expected_direct);
+        peer.await.unwrap();
+    }
+}

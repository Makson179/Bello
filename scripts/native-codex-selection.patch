+#[test]
+fn production_helper_lock_excludes_mutations_without_taking_parent_request_lock() {
+    let root = tempfile::tempdir().expect("tempdir");
+    let original = serde_json::json!({"version": crate::setup::SETUP_VERSION});
+    let encoded = BASE64.encode(serde_json::to_vec(&original).expect("serialize"));
+    let request = SetupRequest::begin(&encoded).expect("production parent request lock");
+    let name = format!(r"Global\CodexSandboxSetupV1-Mutation-{}", request.sid);
+    // The actual helper entry point must acquire B while the parent still owns
+    // A. Taking A in the helper would deadlock this bounded ready handshake.
+    let mut helper = Actor::start(
+        root.path(),
+        "helper",
+        &name,
+        &request.sid,
+        "production_mutation",
+    );
+    let error = acquire_named_lock(&name, &request.sid, /*timeout_ms*/ 10)
+        .err()
+        .expect("production helper must exclude another mutation");
+    assert!(error.to_string().contains("timed out"));
+    helper.finish();
+    let mutation = acquire_setup_mutation_lock(&request.sid).expect("parent post-child lock");
+    drop(mutation);
+    drop(request);
+}

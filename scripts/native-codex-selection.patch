+#[tokio::test]
+async fn native_selection_tcp_preserves_metadata_direct_code_mode_and_poll() {
+    for (name, process_id) in [
+        ("exec_command", None),
+        ("write_stdin", None),
+        ("exec_command", Some(123)),
+        ("write_stdin", Some(123)),
+    ] {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let endpoint = TcpSelector::parse(
+            &listener.local_addr().unwrap().to_string(),
+            &"42".repeat(32),
+        )
+        .unwrap();
+        let peer = tokio::spawn(authenticated_tcp_peer(
+            listener,
+            json!({"text": "ERROR retained\n"}),
+        ));
+        let payload = ToolPayload::Function {
+            arguments: json!({"focus": "inspect test failure"}).to_string(),
+        };
+        let original = output(process_id);
+        let mut expected = original.code_mode_result(&payload);
+        expected["output"] = json!("ERROR retained\n");
+        let mut expected_direct = original.to_response_item("call", &payload);
+        if let ResponseInputItem::FunctionCallOutput { output, .. } = &mut expected_direct
+            && let FunctionCallOutputBody::Text(text) = &mut output.body
+        {
+            *text = text.replace("noise noise noise\nERROR retained\n", "ERROR retained\n");
+        } else {
+            panic!("expected native text body");
+        }
+        let selected = filter_at_endpoint(
+            &ToolName::plain(name),
+            &payload,
+            original,
+            SelectorEndpoint::Tcp(&endpoint),
+        )
+        .await;
+        assert_eq!(selected.code_mode_result(&payload), expected);
+        assert_eq!(selected.to_response_item("call", &payload), expected_direct);
+        assert_eq!(
+            peer.await.unwrap(),
+            json!({"focus": "inspect test failure", "command": "actual original command",
+            "log": "noise noise noise\nERROR retained\n"})
+        );
+    }
+}

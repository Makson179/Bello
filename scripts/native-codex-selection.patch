+#[test]
+fn provisioning_locks_target_identity_but_normal_setup_ignores_payload_user() {
+    let provisioning = serde_json::json!({"mode": "provision-only", "real_user": "SYSTEM"});
+    assert_eq!(
+        request_lock_sid(&provisioning).expect("target SID"),
+        "S-1-5-18"
+    );
+    for mode in ["full", "interactive-provision"] {
+        let ordinary = serde_json::json!({"mode": mode, "real_user": "not-a-real-user"});
+        assert_eq!(
+            request_lock_sid(&ordinary).expect("ordinary SID"),
+            current_user_sid().expect("token SID")
+        );
+    }
+    assert!(request_lock_sid(&serde_json::json!({"mode": "provision-only"})).is_err());

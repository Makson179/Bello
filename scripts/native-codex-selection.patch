+    use tokio::io::AsyncReadExt;
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let endpoint = TcpSelector::parse(
+        &listener.local_addr().unwrap().to_string(),
+        &"42".repeat(32),
+    )
+    .unwrap();
+    let peer = tokio::spawn(async move {
+        let (mut stream, _) = listener.accept().await.unwrap();
+        let hello = read_record(&mut stream, 1024).await.unwrap();
+        assert_eq!(hello.as_object().unwrap().len(), 2);
+        assert!(!hello.to_string().contains(&"42".repeat(32)));
+        send_record(
+            &mut stream,
+            &json!({"nonce": "24".repeat(32), "proof": "00".repeat(32)}),
+        )
+        .await
+        .unwrap();
+        let mut remainder = Vec::new();
+        stream.read_to_end(&mut remainder).await.unwrap();
+        assert!(
+            remainder.is_empty(),
+            "unauthenticated peer received command output"
+        );
+    });
+    let payload = ToolPayload::Function {
+        arguments: json!({"focus": "inspect failure"}).to_string(),
+    };
+    let original = output(None);
+    let expected = original.code_mode_result(&payload);
+    let selected = filter_at_endpoint(
+        &ToolName::plain("exec_command"),
+        &payload,
+        original,
+        SelectorEndpoint::Tcp(&endpoint),
+    )
+    .await;
+    assert_eq!(selected.code_mode_result(&payload), expected);
+    peer.await.unwrap();
+}

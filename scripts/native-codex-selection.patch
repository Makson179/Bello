+#[tokio::test]
+#[cfg(any(unix, windows))]
+async fn bello_native_selection_is_scoped_to_each_thread_spec() {
+    let configure = |turn: &mut TurnContext| {
+        set_features(turn, &[Feature::ShellTool, Feature::UnifiedExec]);
+        set_feature(turn, Feature::ShellZshFork, /*enabled*/ false);
+        set_feature(turn, Feature::CodeMode, /*enabled*/ false);
+        set_feature(turn, Feature::CodeModeOnly, /*enabled*/ false);
+        update_turn_settings_for_test(turn, |settings| {
+            Arc::make_mut(&mut settings.model_info).shell_type = ConfigShellToolType::UnifiedExec;
+        });
+    };
+    let baseline = probe(configure).await;
+    let coder = probe(|turn| {
+        configure(turn);
+        set_feature(turn, Feature::BelloNativeSelection, /*enabled*/ true);
+    })
+    .await;
+    let other_thread = probe(configure).await;
+    for name in ["exec_command", "write_stdin"] {
+        assert!(!has_parameter(baseline.visible_spec(name), "focus"));
+        assert!(has_parameter(coder.visible_spec(name), "focus"));
+        assert_eq!(baseline.visible_spec(name), other_thread.visible_spec(name));
+        let mut stripped = coder.visible_spec(name).clone();
+        let ToolSpec::Function(function) = &mut stripped else {
+            panic!("expected function tool");
+        };
+        function
+            .parameters
+            .properties
+            .as_mut()
+            .unwrap()
+            .remove("focus");
+        assert_eq!(&stripped, baseline.visible_spec(name));
+    }
+}
